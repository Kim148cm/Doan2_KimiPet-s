@model IEnumerable<A25082.Models.SanPhamKemChongNang>
@{
    ViewBag.Title = "Chọn sản phẩm để đánh giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fallback = Url.Content("~/Assets/image/default-image.jpg");
}

<div class="container mt-4">
    <h3 class="mb-4 text-start">CHỌN SẢN PHẨM ĐÁNH GIÁ</h3>
    <div class="row">
        @foreach (var mon in Model)
        {
            var imgs = mon.AnhKemChongNangs?
                .Where(a => !string.IsNullOrWhiteSpace(a.ImageUrl))
                .ToList() ?? new List<A25082.Models.AnhKemChongNang>();

            var hasHover = imgs.Count > 1;
            var primaryImage = Url.Content(imgs.FirstOrDefault()?.ImageUrl ?? fallback);
            var hoverImage = hasHover ? Url.Content(imgs[1].ImageUrl) : null;

            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">
                    <div class="image-container @(hasHover ? "has-hover" : "")">
                        <img src="@primaryImage"
                             alt="@mon.TenKem"
                             class="primary-image"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='@fallback';" />

                        @if (hasHover && !string.IsNullOrEmpty(hoverImage))
                        {
                            <img src="@hoverImage"
                                 alt="@mon.TenKem - Hover"
                                 class="hover-image"
                                 loading="lazy"
                                 onerror="this.closest('.image-container').classList.remove('has-hover'); this.remove();" />
                        }
                    </div>

                    <div class="card-body text-center">
                        <h5 class="card-title">@mon.TenKem</h5>
                        <a href="@Url.Action("DanhGia", "DangNhapNguoiDung", new { MaKem = mon.MaKem })"
                           class="btn-review mt-2">
                            <i class="bi bi-star-fill me-1"></i> Đánh giá
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<style>
    .btn-review {
        display: inline-block;
        padding: 8px 18px;
        font-size: 15px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(45deg, #ff9800, #ff5722);
        border: none;
        border-radius: 50px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(255, 87, 34, 0.4);
    }

        .btn-review i {
            color: #fff700;
        }

        .btn-review:hover {
            transform: scale(1.05);
            background: linear-gradient(45deg, #ff5722, #ff9800);
            box-shadow: 0 6px 14px rgba(255, 87, 34, 0.6);
        }

    .image-container {
        position: relative;
        overflow: hidden;
        width: 100%;
        aspect-ratio: 1/1;
        background: #f7f7f7;
    }

        .image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .image-container .primary-image {
            position: relative;
            z-index: 1;
            transition: opacity .25s;
        }

        .image-container .hover-image {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity .25s;
            pointer-events: none;
        }

        .image-container.has-hover:hover .hover-image {
            opacity: 1;
        }

        .image-container.has-hover:hover .primary-image {
            opacity: 0;
        }
</style>
