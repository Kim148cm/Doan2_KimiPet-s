﻿
@{
    ViewBag.Title = "DangKy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                position: "top-end",
                icon: "success",
                title: "@TempData["SuccessMessage"]",
                showConfirmButton: false,
                timer: 2500
            });
        });
    </script>
}

<section class="body_design_login">
    <div class="body_all_login">
        <div class="body_element_login">
            <h4 class="title_sm_login">Đăng ký</h4>
            <p class="title_small_login">
                Bạn đã có tài khoản thành viên hãy
                <strong><a href="@Url.Action("Index", "DangNhapNguoiDung", new { area = "" })" class="link_login">Đăng Nhập</a></strong> ngay
            </p>

            @using (Html.BeginForm("DangKyNguoiDung", "DangNhapNguoiDung", FormMethod.Post))
            {
                <div class="body_input_login">
                    <input type="text" name="Email" placeholder="Nhập Email..." class="input_main_login" required>
                </div>

                <div class="body_input_login">
                    <input type="password" name="Password" placeholder="Mật khẩu..." class="input_main_login" required>
                </div>

                <div class="body_input_login">
                    <input type="text" name="PhoneNumber" placeholder="Nhập số điện thoại..." class="input_main_login" required>
                </div>

                <div class="body_input_login">
                    <input type="text" name="Address" placeholder="Nhập địa chỉ..." class="input_main_login" required>
                </div>

                <button type="submit" class="btn_login">Đăng ký thông tin</button>
            }
        </div>
    </div>
</section>

<style>
    /* Container đăng ký */
    .body_design_login {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 20vh;
      
    }

    .body_all_login {
        background: white;
        padding: 40px 35px;
        border-radius: 15px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.1);
        max-width: 400px;
        width: 100%;
        transition: all 0.3s ease;
    }

        .body_all_login:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.15);
        }

    /* Title */
    .title_sm_login {
        font-size: 28px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 15px;
        text-align: center;
    }

    .title_small_login {
        font-size: 14px;
        color: #555;
        text-align: center;
        margin-bottom: 25px;
    }

    /* Link đăng nhập */
    .link_login {
        color: #3498db;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
    }

        .link_login:hover {
            color: #21618c;
        }

    /* Inputs */
    .input_main_login {
        width: 100%;
        padding: 12px 15px;
        border-radius: 50px;
        border: 1px solid #ccc;
        margin-bottom: 20px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .input_main_login:focus {
            border-color: #56ab2f;
            box-shadow: 0 4px 12px rgba(86, 171, 47, 0.3);
            outline: none;
        }

    /* Nút đăng ký */
    .btn_login {
        width: 100%;
        padding: 12px 0;
        border-radius: 50px;
        border: none;
        font-weight: 600;
        font-size: 16px;
        color: #fff;
        background: linear-gradient(135deg, #56ab2f, #a8e063);
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(86, 171, 47, 0.4);
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .btn_login:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 8px 20px rgba(86, 171, 47, 0.6);
        }
</style>
