@model A25082.Models.DanhGiaViewModel
@{
    ViewBag.Title = "Đánh giá kem";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card  p-4">
        <h3 class="mb-3 text-primary">Đánh giá : @Model.TenKem</h3>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">Chọn số sao:</label>
                <div id="starRating" class="fs-3 text-warning">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="fa-regular fa-star star" data-value="@i" style="cursor:pointer;"></i>
                    }
                </div>
                @Html.HiddenFor(m => m.Diem)
                @Html.ValidationMessageFor(m => m.Diem, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Bình luận:</label>
                @Html.TextAreaFor(m => m.BinhLuan, new { @class = "form-control", rows = 4, placeholder = "Nhập cảm nhận của bạn..." })
                @Html.ValidationMessageFor(m => m.BinhLuan, "", new { @class = "text-danger" })
            </div>

            @Html.HiddenFor(m => m.MaKem)

            <button type="submit" class="btn-review-submit px-5 py-2">
                <i class="fa-solid fa-paper-plane me-2"></i> Gửi đánh giá
            </button>

        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
   @if (TempData["SuccessMessage"] != null)
    {
        <text>
            Swal.fire({
                icon: 'success',
                title: 'Thành công!',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'OK'
            });
        </text>
    }
</script>


<script>
    const stars = document.querySelectorAll("#starRating .star");
    const hiddenInput = document.querySelector("input[name='Diem']");

    stars.forEach(star => {
        star.addEventListener("click", function () {
            const value = this.getAttribute("data-value");
            hiddenInput.value = value;
            stars.forEach(s => {
                s.classList.remove("fa-solid");
                s.classList.add("fa-regular");
            });
            for (let i = 0; i < value; i++) {
                stars[i].classList.remove("fa-regular");
                stars[i].classList.add("fa-solid");
            }
        });
    });
</script>
<style>
    .btn-review-submit {
        background: linear-gradient(45deg, #ff7e5f, #feb47b);
        color: white;
        font-weight: 600;
        font-size: 16px;
        border: none;
        border-radius: 50px;
        box-shadow: 0 4px 12px rgba(255, 126, 95, 0.4);
        transition: all 0.3s ease;
    }

        .btn-review-submit i {
            transition: transform 0.3s ease;
        }

        .btn-review-submit:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 18px rgba(255, 126, 95, 0.6);
        }

            .btn-review-submit:hover i {
                transform: translateX(4px);
            }
  
    .card h3 {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-weight: 700;
        font-size: 1.8rem;
        background: linear-gradient(135deg, #56ab2f, #a8e063); 
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 1px 1px 4px rgba(0,0,0,0.2);
        margin-bottom: 1.5rem;
        position: relative;
    }

      
        .card h3::after {
            content: '';
            display: block;
            width: 60px;
            height: 4px;
            background: linear-gradient(135deg, #56ab2f, #a8e063);
            border-radius: 2px;
            margin-top: 6px;
        }

  
    #starRating .star {
        transition: transform 0.2s ease, color 0.3s ease;
    }

        #starRating .star:hover {
            transform: scale(1.3);
            color: #ffdd00;
        }

 
    textarea.form-control:focus {
        border-color: #56ab2f;
        box-shadow: 0 0 5px rgba(86, 171, 47, 0.5);
        transition: all 0.3s ease;
    }
</style>