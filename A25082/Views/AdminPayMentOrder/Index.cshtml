@model List<A25082.Models.ThanhToan>
@{
    ViewBag.Title = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    int confirmedCount = Model.Count(p => p.TrangThai == "Đã xác nhận");
    int pendingCount = Model.Count(p => p.TrangThai == "Chờ xác nhận");
    int totalCount = Model.Count();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="admin-order-management">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header-admin">
            <div class="header-left">
                <h1 class="page-title-admin">
                    <i class="fa-solid fa-receipt"></i>
                    Quản lý đơn hàng
                </h1>
                <p class="page-subtitle-admin">Theo dõi và xử lý đơn hàng của khách hàng</p>
            </div>
            <div class="header-right">
                <button onclick="exportExcel()" class="btn-export">
                    <i class="fa-solid fa-file-excel"></i>
                    Xuất Excel
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon stat-icon-total">
                    <i class="fa-solid fa-shopping-cart"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Tổng đơn hàng</span>
                    <span class="stat-value">@totalCount</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon stat-icon-pending">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Chờ xác nhận</span>
                    <span class="stat-value">@pendingCount</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon stat-icon-confirmed">
                    <i class="fa-solid fa-check-circle"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Đã xác nhận</span>
                    <span class="stat-value">@confirmedCount</span>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="table-container">
            @if (Model == null || !Model.Any())
            {
                <div class="empty-state-admin">
                    <i class="fa-solid fa-inbox"></i>
                    <h3>Chưa có đơn hàng nào</h3>
                    <p>Danh sách đơn hàng sẽ hiển thị tại đây</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th style="width: 100px;">Mã ĐH</th>
                                <th style="width: 180px;">Khách hàng</th>
                                <th style="width: 120px;">Liên hệ</th>
                                <th style="width: 220px;">Địa chỉ</th>
                                <th style="width: 250px;">Sản phẩm</th>
                                <th style="width: 80px;" class="text-center">SL</th>
                                <th style="width: 120px;" class="text-right">Tổng tiền</th>
                                <th style="width: 100px;" class="text-center">Thanh toán</th>
                                <th style="width: 120px;" class="text-center">Trạng thái</th>
                                <th style="width: 180px;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="order-code">#@payment.MaThanhToan</span>
                                        <span class="order-date-small">@payment.NgayTao.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td>
                                        <div class="customer-info-cell">
                                            <span class="customer-name" title="@payment.HoTen">@payment.HoTen</span>
                                            <span class="customer-email" title="@payment.Email">@payment.Email</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="contact-phone">@payment.SoDienThoai</span>
                                    </td>
                                    <td>
                                        <div class="address-cell">
                                            <span class="address-main" title="@payment.DiaChi">
                                                @(payment.DiaChi.Length > 30 ? payment.DiaChi.Substring(0, 30) + "..." : payment.DiaChi)
                                            </span>
                                            <span class="address-sub" title="@payment.Phuong, @payment.Huyen, @payment.Tinh">
                                                @(payment.Phuong.Length > 15 ? payment.Phuong.Substring(0, 15) + "..." : payment.Phuong), @payment.Huyen
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="products-cell">
                                            @if (payment.ChiTietThanhToans != null && payment.ChiTietThanhToans.Any())
                                            {
                                                foreach (var item in payment.ChiTietThanhToans.Take(2))
                                                {
                                                    var productName = item.TenKem;
                                                    var displayName = productName.Length > 35 ? productName.Substring(0, 35) + "..." : productName;
                                                    <div class="product-item-cell" title="@productName">
                                                        <span class="product-name-truncate">@displayName</span>
                                                        <span class="product-qty-badge">×@item.SoLuong</span>
                                                    </div>
                                                }
                                                if (payment.ChiTietThanhToans.Count > 2)
                                                {
                                                    <span class="product-more">+@(payment.ChiTietThanhToans.Count - 2) sản phẩm khác</span>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="qty-badge">@payment.SoLuong</span>
                                    </td>
                                    <td class="text-right">
                                        <span class="amount-cell">@payment.SoTienThanhToan.ToString("N0")₫</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="payment-badge payment-@payment.PhuongThucThanhToan.ToLower()">
                                            @payment.PhuongThucThanhToan
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (payment.TrangThai == "Chờ xác nhận")
                                        {
                                            <span class="status-badge status-pending">
                                                <i class="fa-solid fa-clock"></i> Chờ xác nhận
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-confirmed">
                                                <i class="fa-solid fa-check"></i> Đã xác nhận
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="action-buttons">
                                            <button class="btn-action btn-view" onclick="viewOrderDetail(@payment.MaThanhToan)" title="Xem chi tiết">
                                                <i class="fa-solid fa-eye"></i>
                                            </button>
                                            @if (payment.TrangThai == "Chờ xác nhận")
                                            {
                                                <button class="btn-action btn-confirm" onclick="confirmPayment(@payment.MaThanhToan)" title="Xác nhận">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-action btn-cancel" onclick="cancelConfirmation(@payment.MaThanhToan)" title="Hủy xác nhận">
                                                    <i class="fa-solid fa-undo"></i>
                                                </button>
                                            }
                                            <button class="btn-action btn-delete" onclick="deletePayment(@payment.MaThanhToan)" title="Xóa">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Chi tiết đơn hàng -->
<div class="modal fade" id="orderDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-file-invoice"></i> Chi tiết đơn hàng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="orderDetailContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-color: #059669;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --danger-color: #ef4444;
        --info-color: #3b82f6;
        --text-primary: #111827;
        --text-secondary: #6b7280;
        --border-color: #e5e7eb;
        --bg-gray: #f9fafb;
    }

    .admin-order-management {
        background-color: var(--bg-gray);
        min-height: 100vh;
        padding: 2rem 0;
    }

    /* Page Header */
    .page-header-admin {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .page-title-admin {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .page-title-admin i {
        color: var(--primary-color);
    }

    .page-subtitle-admin {
        font-size: 15px;
        color: var(--text-secondary);
        margin: 0;
    }

    .btn-export {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background-color: var(--success-color);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-export:hover {
        background-color: #059669;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .stat-icon-total {
        background-color: #dbeafe;
        color: #1e40af;
    }

    .stat-icon-pending {
        background-color: #fef3c7;
        color: #92400e;
    }

    .stat-icon-confirmed {
        background-color: #d1fae5;
        color: #065f46;
    }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 0.25rem;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
    }

    /* Table Container */
    .table-container {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .orders-table thead {
        background-color: var(--bg-gray);
        border-bottom: 2px solid var(--border-color);
    }

    .orders-table th {
        padding: 1rem;
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .orders-table tbody tr {
        border-bottom: 1px solid var(--border-color);
        transition: background-color 0.2s;
    }

    .orders-table tbody tr:hover {
        background-color: var(--bg-gray);
    }

    .orders-table td {
        padding: 1rem;
        font-size: 14px;
        color: var(--text-primary);
        vertical-align: top;
    }

    /* Table Cell Styles */
    .order-code {
        display: block;
        font-weight: 600;
        color: var(--primary-color);
    }

    .order-date-small {
        display: block;
        font-size: 12px;
        color: var(--text-secondary);
        margin-top: 0.25rem;
    }

    .customer-info-cell {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .customer-name {
        font-weight: 500;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
    }

    .customer-email {
        font-size: 12px;
        color: var(--text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
    }

    .contact-phone {
        font-size: 14px;
        color: var(--text-primary);
    }

    .address-cell {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .address-main {
        font-size: 13px;
        color: var(--text-primary);
        display: block;
    }

    .address-sub {
        font-size: 12px;
        color: var(--text-secondary);
        display: block;
    }

    .products-cell {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .product-item-cell {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        font-size: 13px;
    }

    .product-name-truncate {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .product-qty-badge {
        background-color: var(--bg-gray);
        padding: 0.125rem 0.5rem;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 500;
        color: var(--text-secondary);
        flex-shrink: 0;
    }

    .product-more {
        font-size: 11px;
        color: var(--text-secondary);
        font-style: italic;
    }

    .qty-badge {
        background-color: var(--bg-gray);
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .amount-cell {
        font-weight: 700;
        color: var(--primary-color);
        font-size: 15px;
    }

    .payment-badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
    }

    .payment-cod {
        background-color: #dbeafe;
        color: #1e40af;
    }

    .payment-vnpay {
        background-color: #fce7f3;
        color: #9f1239;
    }

    .payment-bank {
        background-color: #e0e7ff;
        color: #3730a3;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
    }

    .status-pending {
        background-color: #fef3c7;
        color: #92400e;
    }

    .status-confirmed {
        background-color: #d1fae5;
        color: #065f46;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }

    .btn-view {
        background-color: #dbeafe;
        color: #1e40af;
    }

    .btn-view:hover {
        background-color: #3b82f6;
        color: white;
    }

    .btn-confirm {
        background-color: #d1fae5;
        color: #065f46;
    }

    .btn-confirm:hover {
        background-color: #10b981;
        color: white;
    }

    .btn-cancel {
        background-color: #fef3c7;
        color: #92400e;
    }

    .btn-cancel:hover {
        background-color: #f59e0b;
        color: white;
    }

    .btn-delete {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .btn-delete:hover {
        background-color: #ef4444;
        color: white;
    }

    /* Empty State */
    .empty-state-admin {
        text-align: center;
        padding: 4rem 2rem;
    }

    .empty-state-admin i {
        font-size: 64px;
        color: var(--text-secondary);
        opacity: 0.5;
        margin-bottom: 1rem;
    }

    .empty-state-admin h3 {
        font-size: 20px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }

    .empty-state-admin p {
        font-size: 15px;
        color: var(--text-secondary);
    }

    /* Modal Styles */
    .modal-header {
        border-bottom: 1px solid var(--border-color);
        padding: 1.5rem;
        background-color: var(--bg-gray);
    }

    .modal-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modal-title i {
        color: var(--primary-color);
    }

    .modal-body {
        padding: 1.5rem;
    }

    .order-detail .section-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.75rem;
        display: block;
    }

    .order-detail p {
        margin-bottom: 0.5rem;
        font-size: 14px;
    }

    .order-detail strong {
        color: var(--text-primary);
        font-weight: 600;
    }

    /* Utility Classes */
    .text-center {
        text-align: center !important;
    }

    .text-right {
        text-align: right !important;
    }

    /* Responsive */
    media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        }
    }

    media (max-width: 768px) {
        .page-header-admin {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .orders-table {
            font-size: 12px;
        }

        .orders-table th,
        .orders-table td {
            padding: 0.75rem 0.5rem;
        }
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // ==================== XEM CHI TIẾT ĐƠN HÀNG ====================
    function viewOrderDetail(maThanhToan) {
        $.ajax({
            url: "/AdminPayMentOrder/GetOrderDetail",
            type: "GET",
            data: { id: maThanhToan },
            success: function (data) {
                if (data.success) {
                    const order = data.order;
                    let productsHtml = '';

                    order.ChiTietThanhToans.forEach(function (item) {
                        productsHtml += `
                            <tr>
                                <td>${item.TenKem}</td>
                                <td class="text-center">${item.SoLuong}</td>
                                <td class="text-end">${item.DonGia.toLocaleString('vi-VN')}₫</td>
                                <td class="text-end fw-bold">${item.ThanhTien.toLocaleString('vi-VN')}₫</td>
                            </tr>
                        `;
                    });

                    // Format ngày
                    const ngayTao = new Date(order.NgayTao);
                    const ngayTaoFormatted = ngayTao.toLocaleDateString('vi-VN', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });

                    const html = `
                        <div class="order-detail">
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <h6 class="section-label">Thông tin khách hàng</h6>
                                    <p><strong>Họ tên:</strong> ${order.HoTen}</p>
                                    <p><strong>Email:</strong> ${order.Email}</p>
                                    <p><strong>SĐT:</strong> ${order.SoDienThoai}</p>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="section-label">Thông tin đơn hàng</h6>
                                    <p><strong>Mã đơn:</strong> #${order.MaThanhToan}</p>
                                    <p><strong>Ngày tạo:</strong> ${ngayTaoFormatted}</p>
                                    <p><strong>Trạng thái:</strong> <span class="badge ${order.TrangThai === 'Đã xác nhận' ? 'bg-success' : 'bg-warning text-dark'}">${order.TrangThai}</span></p>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="section-label">Địa chỉ giao hàng</h6>
                                <p>${order.DiaChi}, ${order.Phuong}, ${order.Huyen}, ${order.Tinh}</p>
                            </div>

                            <div class="mb-4">
                                <h6 class="section-label">Sản phẩm</h6>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Tên sản phẩm</th>
                                                <th class="text-center" style="width: 100px;">SL</th>
                                                <th class="text-end" style="width: 120px;">Đơn giá</th>
                                                <th class="text-end" style="width: 120px;">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            ${productsHtml}
                                        </tbody>
                                        <tfoot>
                                            <tr class="table-light">
                                                <td colspan="3" class="text-end"><strong>Tổng cộng:</strong></td>
                                                <td class="text-end"><strong class="text-success fs-5">${order.SoTienThanhToan.toLocaleString('vi-VN')}₫</strong></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            <div>
                                <p><strong>Phương thức thanh toán:</strong> <span class="badge bg-info">${order.PhuongThucThanhToan}</span></p>
                            </div>
                        </div>
                    `;

                    $('#orderDetailContent').html(html);
                    const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
                    modal.show();
                } else {
                    Swal.fire("Lỗi!", data.message || "Không thể tải chi tiết đơn hàng", "error");
                }
            },
            error: function () {
                Swal.fire("Lỗi!", "Có lỗi xảy ra khi tải dữ liệu", "error");
            }
        });
    }

    // ==================== XUẤT EXCEL ====================
    function exportExcel() {
        $.ajax({
            url: "/AdminPayMentOrder/ExportConfirmedPayments",
            type: "GET",
            xhrFields: {
                responseType: 'blob'
            },
            success: function (data, status, xhr) {
                if (xhr.getResponseHeader("Content-Type").indexOf("application/json") !== -1) {
                    let reader = new FileReader();
                    reader.onload = function () {
                        let result = JSON.parse(reader.result);
                        Swal.fire("Thông báo", result.message, "info");
                    };
                    reader.readAsText(data);
                } else {
                    let blob = new Blob([data], { type: "application/vnd.ms-excel" });
                    let link = document.createElement("a");
                    link.href = window.URL.createObjectURL(blob);
                    link.download = "DonHangXacNhan_" + new Date().getTime() + ".xls";
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    Swal.fire("Thành công!", "Đã xuất file Excel", "success");
                }
            },
            error: function () {
                Swal.fire("Thông báo", "Chưa có đơn hàng nào được xác nhận!", "error");
            }
        });
    }

    // ==================== XÁC NHẬN ĐƠN HÀNG ====================
    function confirmPayment(maThanhToan) {
        Swal.fire({
            title: "Xác nhận đơn hàng?",
            text: "Đơn hàng sẽ được xác nhận và giao cho bên vận chuyển",
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#10b981",
            cancelButtonColor: "#6b7280",
            confirmButtonText: "Xác nhận",
            cancelButtonText: "Hủy"
        }).then((result) => {
            if (result.isConfirmed) {
                $.post("/AdminPayMentOrder/ConfirmPayment", { id: maThanhToan }, function (data) {
                    if (data.success) {
                        Swal.fire("Thành công!", data.message, "success").then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire("Lỗi!", data.message, "error");
                    }
                }).fail(function () {
                    Swal.fire("Lỗi!", "Có lỗi xảy ra khi xác nhận đơn hàng", "error");
                });
            }
        });
    }

