@model List<A25082.Models.VaiTro>
@{
    ViewBag.Title = "Quản lý Vai trò";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

<div class="container mt-4">
    <h5 class="mb-0"><i class="fas fa-user-shield class-icons"></i> QUẢN LÝ VAI TRÒ (ROLES)</h5>

    <div class="card shadow-sm p-4 mt-4">
        <input type="hidden" id="roleId" value="0">
        <div class="mb-3">
            <label for="roleName" class="form-label fw-bold">Tên vai trò:</label>
            <input type="text" id="roleName" class="form-control" placeholder="Nhập tên vai trò">
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-success" onclick="saveRole()">
                <i class="fas fa-save"></i> Lưu thông tin
            </button>
            <button class="btn btn-secondary" onclick="resetForm()">Hủy bỏ</button>
        </div>
    </div>

    <div class="card shadow-sm mt-5">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">DANH SÁCH VAI TRÒ</h5>
        </div>
        <div class="card-body">
            <table class="table table-hover table-bordered">
                <thead class="table-dark text-center">
                    <tr>
                        <th>#</th>
                        <th>Tên vai trò</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr class="align-middle">
                            <td class="text-center">@role.MaVaiTro</td>
                            <td>@role.TenVaiTro</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm me-2" onclick="editRole(@role.MaVaiTro, '@role.TenVaiTro')">
                                    <i class="fas fa-edit"></i> Sửa
                                </button>
                                <button class="btn btn-danger btn-sm" onclick="deleteRole(@role.MaVaiTro)">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .class-icons {
        background-color: forestgreen;
        color: white;
        padding: 1rem;
        border-radius: 50%;
    }
</style>
<script>
    function saveRole() {
        var id = $('#roleId').val();
        var name = $('#roleName').val();

        if (!name) {
            Swal.fire("Lỗi!", "Vui lòng nhập tên vai trò!", "error");
            return;
        }

        $.ajax({
            url: '/AdminRole/SaveRole',
            type: 'POST',
            data: { MaVaiTro: id, TenVaiTro: name },
            success: function (res) {
                Swal.fire(res.success ? "Thành công!" : "Lỗi!", res.message, res.success ? "success" : "error")
                    .then(() => { if (res.success) location.reload(); });
            }
        });
    }


    function editRole(id, name) {
        Swal.fire({
            title: 'CHỈNH SỬA THÔNG TIN QUYỀN TRUY CẬP',
            html: `
                <input type="hidden" id="editRoleId" value="${id}">
                <div class="mb-3">
                    <label for="editRoleName" class="form-label fw-bold label_category">Tên vai trò</label>
                    <input type="text" id="editRoleName" class="form-control" value="${name}">
                </div>
            `,
            showCancelButton: true,
            confirmButtonText: 'Cập nhật',
            cancelButtonText: 'Hủy',
            preConfirm: () => {
                const newId = $('#editRoleId').val();
                const newRoleName = $('#editRoleName').val();

                if (!newRoleName) {
                    Swal.showValidationMessage("Vui lòng nhập tên vai trò!");
                    return false;
                }

                return { MaVaiTro: newId, TenVaiTro: newRoleName };
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/AdminRole/SaveRole',
                    type: 'POST',
                    data: result.value,
                    beforeSend: function () {
                        Swal.fire({
                            title: "Đang cập nhật...",
                            text: "Vui lòng đợi...",
                            allowOutsideClick: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                    },
                    success: function (res) {
                        Swal.fire({
                            title: res.success ? "Thành công!" : "Thất bại!",
                            text: res.message,
                            icon: res.success ? "success" : "error",
                            confirmButtonText: "OK"
                        }).then(() => {
                            if (res.success) location.reload();
                        });
                    }
                });
            }
        });
    }

    function deleteRole(id) {
        Swal.fire({
            title: "Xác nhận xóa?",
            text: "Bạn có chắc chắn muốn xóa vai trò này?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Xóa"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/AdminRole/DeleteRole',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        Swal.fire(res.success ? "Đã xóa!" : "Lỗi!", res.message, res.success ? "success" : "error")
                            .then(() => { if (res.success) location.reload(); });
                    }
                });
            }
        });
    }

    function resetForm() {
        $("#roleId").val("0");
        $("#roleName").val("");

        Swal.fire({
            title: "Đã đặt lại!",
            text: "Thông tin trong trường nhập đã đặt lại!",
            icon: "info",
            confirmButtonText: "OK"
        });
    }
</script>
