@model IEnumerable<A25082.Models.SanPhamKemChongNang>


@{
    ViewBag.Title = "AllClothers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<section class="body_part_two_cart body-big-screen">

    <div class="body_two_title_cart">
        <h4 class="title_h_cart" style="text-align:center;">Kết quả tìm kiếm của bạn</h4>

    </div>


</section>

    @if (Model != null && Model.Any())

    {
        <p>Không tìm thấy sản phẩm nào.</p>
    }
    else
    {
        <div class="container_body_sale" style="margin-top: 1rem;">
            <div class="row row_pr_sale" id="product-list">
                @Html.Action("LoadProductSearch", "Search")
            </div>
        </div>
    }


<script>
    $(document).ready(function () {
        $("#sortBy").change(function () {
            var sortOrder = $(this).val(); // Lấy giá trị đã chọn từ dropdown
            $.ajax({
                url: '@Url.Action("LoadProductSearch", "Search")',
                type: 'GET',
                data: { sortOrder: sortOrder },
                success: function (response) {
                    $("#product-list").html(response); // Cập nhật danh sách sản phẩm
                },
                error: function () {
                    alert("Lỗi khi tải sản phẩm.");
                }
            });
        });
    });
</script>