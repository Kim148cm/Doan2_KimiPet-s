@model A25082.Models.NguoiDung
@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header text-center text-white p-4" style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); border-top-left-radius: .75rem; border-top-right-radius: .75rem;">
            <h3 class="mb-0 fw-bold">HỒ SƠ CÁ NHÂN</h3>
        </div>
        <div class="card-body p-5">
            <div class="row align-items-center">
                <!-- Avatar và tên người dùng -->
                <div class="col-md-4 text-center mb-4 mb-md-0">
                    <div class="position-relative d-inline-block">
                        <img src="~/Assets/image/user.png"
                             class="rounded-circle border border-4 border-primary shadow-sm"
                             alt="User Avatar"
                             width="120" height="120">
                        <span class="position-absolute bottom-0 end-0 p-2 bg-success rounded-circle border border-white" title="Online"></span>
                    </div>
                    <h4 class="mt-3 text-primary fw-semibold">@Model.TenDangNhap</h4>
                    <p class="text-muted">@Model.Email</p>
                </div>

                <!-- Thông tin tài khoản -->
                <div class="col-md-8">
                    <h5 class="mb-3 text-secondary">
                        <i class="bi bi-person-circle me-2"></i> Thông tin tài khoản
                    </h5>
                    <ul class="list-group list-group-flush rounded shadow-sm">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-envelope me-2 text-primary"></i>Email</span>
                            <strong>@Model.Email</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-telephone me-2 text-success"></i>Số điện thoại</span>
                            <strong>@(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-calendar-check me-2 text-warning"></i>Ngày tạo</span>
                            <strong>@Model.NgayTao.ToString("dd/MM/yyyy")</strong>
                        </li>
                    </ul>

                    <!-- Nút Đăng Xuất -->
                    <button id="logoutBtn" class="btn btn-danger mt-4 px-4 py-2 fw-bold shadow-sm">
                        <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SweetAlert2 + JavaScript -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.getElementById("logoutBtn").addEventListener("click", function () {
        Swal.fire({
            title: "Bạn có chắc muốn đăng xuất?",
            text: "Bạn sẽ cần đăng nhập lại!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Đăng xuất",
            cancelButtonText: "Hủy"
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: "Đang đăng xuất...",
                    text: "Vui lòng chờ giây lát!",
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                fetch("@Url.Action("DangXuat", "AdminProfile")", {
                    method: "POST",
                    credentials: "same-origin"
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = "@Url.Action("Index", "DangNhapNguoiDung")";
                    } else {
                        Swal.fire("Lỗi!", "Đăng xuất không thành công, vui lòng thử lại!", "error");
                    }
                })
                .catch(error => {
                    Swal.fire("Lỗi!", "Đã xảy ra lỗi khi đăng xuất!", "error");
                });
            }
        });
    });
</script>

<style>
    .list-group-item {
        transition: all 0.3s;
    }

        .list-group-item:hover {
            background-color: #f1f1f1;
            transform: translateX(5px);
        }

    #logoutBtn:hover {
        transform: scale(1.05);
        transition: transform 0.3s;
    }
</style>
