
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Biểu mẫu nhập danh mục hình ảnh -->
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-images"></i> QUẢN LÝ DANH MỤC HÌNH ẢNH</h5>
        </div>
        <div class="card-body">
            <input type="hidden" id="imageCategoryId" value="0">
            <div class="mb-3">
                <label for="imageCategoryName" class="form-label">Tên Danh Mục Hình Ảnh:</label>
                <input type="text" id="imageCategoryName" class="form-control" placeholder="Nhập tên danh mục hình ảnh">
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-success" onclick="saveImageCategory()">
                    <i class="fas fa-save"></i> Lưu thông tin
                </button>
                <button class="btn btn-secondary" onclick="resetImageCategoryForm()">
                    <i class="fas fa-times"></i> Hủy bỏ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách danh mục hình ảnh -->
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="fas fa-list"></i> DANH SÁCH DANH MỤC HÌNH ẢNH</h5>
        </div>


        <div class="card-body">
            <table class="table table-bordered table-hover text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Tên Danh Mục</th>
                     
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody id="imageCategoryTable">
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.MaLoaiAnh">
                            <td class="name">@item.TenLoaiAnh</td>                          
                            <td>
                                <button class="btn btn-warning btn-sm" onclick="editImageCategory(@item.MaLoaiAnh, '@item.TenLoaiAnh')">
                                    <i class="fas fa-edit"></i> Sửa
                                </button>
                                <button class="btn btn-danger btn-sm" onclick="deleteImageCategory(@item.MaLoaiAnh)">
                                    <i class="fas fa-trash-alt"></i> Xóa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>


    </div>
</div>

<!-- Import Bootstrap 5 và FontAwesome -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>


<script>
    // 📌 Lưu danh mục hình ảnh
    function saveImageCategory() {
        var id = $("#imageCategoryId").val();
        var name = $("#imageCategoryName").val().trim();

        if (!name) {
            Swal.fire("Lỗi!", "Tên danh mục không được để trống!", "error");
            return;
        }

        $.ajax({
            type: "POST",
            url: "/ImageCategories/SaveCategory",
            data: { MaLoaiAnh: id, TenLoaiAnh: name },
            success: function (res) {
                if (res.success) {
                    Swal.fire("Thành công!", "Danh mục đã được lưu!", "success").then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire("Lỗi!", res.message, "error");
                }
            },
            error: function () {
                Swal.fire("Lỗi hệ thống!", "Vui lòng thử lại!", "error");
            }
        });

    }
    // Code thay đổi thông tin loại ảnh -----------------------------------------
    function editImageCategory(id, name) {
        Swal.fire({
            title: 'CHỈNH SỬA TÊN DANH MỤC HÌNH ẢNH',
            html: `
            <input type="hidden" id="editImageCategoryId" value="${id}">
            <div class="mb-3">
                <label for="editImageCategoryName" class="form-label fw-bold label_category">Tên danh mục</label>
                <input type="text" id="editImageCategoryName" class="form-control" value="${name}">
            </div>
         `,

            showCancelButton: true,
            confirmButtonText: 'Cập nhật',
            cancelButtonText: 'Hủy',
            preConfirm: () => {
                const newId = $('#editImageCategoryId').val();
                const newImageCategoryName = $('#editImageCategoryName').val().trim();

                if (!newImageCategoryName) {
                    Swal.showValidationMessage("Vui lòng nhập tên danh mục!");
                    return false;
                }

                return { MaLoaiAnh: newId, TenLoaiAnh: newImageCategoryName };

            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/ImageCategories/SaveCategory',
                    type: 'POST',
                    data: result.value,
                    beforeSend: function () {
                        Swal.fire({
                            title: "Đang cập nhật...",
                            text: "Vui lòng đợi...",
                            allowOutsideClick: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                    },
                    // ------------------------------------> Thông báo khi thay đổi
                    success: function (res) {
                        Swal.fire({
                            title: res.success ? "Cập nhật thành công!" : "Thất bại!",
                            text: res.message,
                            icon: res.success ? "success" : "error",
                            confirmButtonText: "OK"
                        }).then(() => { // --------> TỰ động loading lại dữ liệu thay đổi
                            if (res.success) {
                                location.reload();
                            }
                        });
                    }
                });
            }
        });
    }



    // ---------------------------------------------------------------------------------

    // 📌 Xóa danh mục hình ảnh
    function deleteImageCategory(id) {
        Swal.fire({
            title: "Bạn có chắc muốn xóa?",
            text: "Bạn sẽ không thể hoàn tác!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Có, xóa nó!",
            cancelButtonText: "Không, hủy!",
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.post("/ImageCategories/DeleteCategory", { MaLoaiAnh: id }, function (res) {
                    if (res.success) {
                        Swal.fire("Đã xóa!", "Danh mục đã bị xóa.", "success").then(() => {
                            $("tr[data-id='" + id + "']").remove();
                        });
                    } else {
                        Swal.fire("Lỗi!", res.message, "error");
                    }
                });
            }
        });
    }

    // 📌 Reset form nhập danh mục
    function resetImageCategoryForm() {
        $("#imageCategoryId").val("0");
        $("#imageCategoryName").val("");

        Swal.fire({
            title: "Đã đặt lại!",
            text: "Trường nhập đã được đặt lại !",
            icon: "info",
            confirmButtonText: "OK"
        });

    }

</script>