@model IEnumerable<A25082.Models.LoaiKemChongNang>

@{
    ViewBag.Title = "DanhMucAdmin";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Thêm Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">


<div class="container mt-4">
    <h5 class="text-lg-start">  <i class="fa-solid fa-list class-icons"></i> QUẢN LÝ DANH MỤC</h5>

    <!-- Form thêm/sửa danh mục -->
    <div class="card p-4 shadow-sm" style="margin-top:1rem;">
        <input type="hidden" id="categoryId" value="0">
        <div class="mb-3">
            <label class="form-label">Tên Danh Mục:</label>
            <input type="text" id="categoryName" class="form-control" placeholder="Nhập tên danh mục">
        </div>
        <div class="text-lg-start">
            <button class="btn btn-success" onclick="saveCategory()"> <i class="fas fa-save"></i> Lưu thông tin</button>
            <button class="btn btn-secondary" onclick="resetForm()">Hủy bỏ</button>
        </div>
    </div>




 

    <table class="table table-bordered mt-2 text-center">
        <thead class="table-dark">
            <tr>
                <th>Tên Danh Mục</th>
                <th>Ngày Tạo</th>
                <th>Hành Động</th>
            </tr>
        </thead>
        <tbody id="categoryTable">
            @foreach (var item in Model)
            {
                <tr data-id="@item.MaLoai">
                    <td class="name">@item.TenLoai</td>
                    <td>@DateTime.Now.ToString("dd/MM/yyyy")</td> <!-- Nếu chưa có NgayTao -->
                    <td>
                        <button class="btn btn-warning btn-sm" onclick="editCategory(@item.MaLoai, '@item.TenLoai')">
                            <i class="fas fa-edit"></i> Sửa
                        </button>
                        <button class="btn btn-danger btn-sm" onclick="deleteCategory(@item.MaLoai)">
                            <i class="fas fa-trash"></i> Xóa
                        </button>
                    </td>
                </tr>

            }
        </tbody>
    </table>

   

</div>



<style>
    .class-icons {
        background-color: forestgreen;
        color: white;
        padding: 1rem;
        border-radius: 50%;
    }
</style>
<!-- Xử lý Ajax -->
<script>

    // XỬ LÍ TÌM KIẾM THÔNG TIN TRONG BẢNG ----------------------------------------------------------------------------
    $(document).ready(function () {
    updateCategoryCount(); // Cập nhật số lượng danh mục ban đầu

    // Xử lý khi nhấn nút "Tìm" hoặc Enter trong ô tìm kiếm
    $('#searchBtn').on('click', handleSearch);
    $('#searchCategory').on('keypress', function (e) {
        if (e.which === 13) handleSearch();
    });

    function handleSearch() {
        const keyword = $('#searchCategory').val().trim();
        searchCategory(keyword);
    }

    function searchCategory(keyword) {
        $.ajax({
            url: '@Url.Action("SearchCategory", "HomeAdmin")',
            type: 'GET',
            data: { keyword },
            success: function (data) {
                $('#categoryTable').empty();
                $('#noResultsMessage').toggle(data.length === 0);

                if (data.length > 0) {
                    data.forEach(item => {
                        $('#categoryTable').append(`
                            <tr data-id="${item.Id}">
                                <td class="name">${item.Name}</td>
                                <td>${item.CreatedAt}</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" onclick="editCategory(${item.Id}, '${item.Name}')">
                                        <i class="fas fa-edit"></i> Sửa
                                    </button>
                                    <button class="btn btn-danger btn-sm" onclick="deleteCategory(${item.Id})">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        `);
                    });
                }

                updateCategoryCount();
            },
            error: function (xhr, status, error) {
                console.error("Lỗi AJAX:", error);
                Swal.fire('Lỗi!', 'Không thể tìm kiếm danh mục.', 'error');
            }
        });
    }

    function updateCategoryCount() {
        let count = $('#categoryTable tr').length;
        $('#categoryCount').text(count);
    }
});



    // ----------------------------------------------------------------------------------------------------------------------------------
    // XỬ lý thêm dữ liệu mới

    function saveCategory() {
        var id = $("#categoryId").val();
        var name = $("#categoryName").val();

        if (name.trim() === "") {
            Swal.fire("Lỗi!", "Vui lòng nhập tên danh mục!", "error");
            return;
        }

        $.ajax({
            type: "POST",
            url: "/HomeAdmin/SaveCategory",
            data: { Id: id, Name: name },
            success: function (res) {
                if (res.success) {
                    Swal.fire({
                        title: "Thành công!",
                        text: "Danh mục đã được lưu.",
                        icon: "success",
                        confirmButtonText: "OK"
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire("Lỗi!", res.message, "error");
                }
            },
            error: function (xhr, status, error) {
                console.error(xhr.responseText);
                Swal.fire("Lỗi hệ thống!", "Xem console để biết chi tiết.", "error");
            }
        });
    }


    // ----------------------------------------------------------------------------------------------------------------------------------

    // Xử lý thay đổi dữ liệu

    function editCategory(id, name) {

        // ------------ Thông báo Model

        Swal.fire({
            title: 'CHỈNH SỬA DANH MỤC',
            html: `
        <input type="hidden" id="editCategoryId" value="${id}">
        <div class="mb-3">
            <label for="editCategoryName" class="form-label fw-bold label_category">Tên danh mục</label>
            <input type="text" id="editCategoryName" class="form-control" value="${name}">
        </div>
    `,

     // --------------------------
            showCancelButton: true,
            confirmButtonText: 'Cập nhật',
            cancelButtonText: 'Hủy',
            preConfirm: () => { // ---------------------------------------> Kiểm tra Data trước khi xác nhận
                const newId = $('#editCategoryId').val();
                const newName = $('#editCategoryName').val();

                if (!newName) {
                    Swal.showValidationMessage("Vui lòng nhập tên danh mục!");
                    return false;
                }

                return { id: newId, name: newName };
            }

            // ---------------------------------------- > Sau khi nhập và xác nhận thì xử lý thay đổi
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/HomeAdmin/SaveCategory',
                    type: 'POST',
                    data: result.value,
                    beforeSend: function () {
                        Swal.fire({
                            title: "Đang cập nhật...",
                            text: "Vui lòng đợi...",
                            allowOutsideClick: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                    },
                    // ------------------------------------> Thông báo khi thay đổi
                    success: function (res) {
                        Swal.fire({
                            title: res.success ? "Thành công!" : "Thất bại!",
                            text: res.message,
                            icon: res.success ? "success" : "error",
                            confirmButtonText: "OK"
                        }).then(() => { // --------> TỰ động loading lại dữ liệu thay đổi
                            if (res.success) {
                                location.reload();
                            }
                        });
                    }
                });
            }
        });
    }
 // ----------------------------------------------------------------------------------------------------------------------------------
    // Xử lý xóa dữ liệu

    function deleteCategory(id) {
        Swal.fire({
            title: "Bạn có chắc muốn xóa?",
            text: "Bạn sẽ không thể hoàn tác!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Có, xóa nó!",
            cancelButtonText: "Không, hủy!",
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.post("/HomeAdmin/DeleteCategory", { id: id }, function (res) {
                    if (res.success) {
                        $("tr[data-id='" + id + "']").remove();
                        Swal.fire("Đã xóa!", "Danh mục đã bị xóa.", "success");
                    } else {
                        Swal.fire("Lỗi!", res.message, "error");
                    }
                });
            } else {
                Swal.fire("Hủy bỏ", "Danh mục vẫn giữ nguyên.", "error");
            }
        });
    }

    // Thông báo đặt reset lại trường nhập -----------------------------------------------------------------------------------

    function resetForm() {
        $("#categoryId").val("0"); // KHóa cho = 0 ------------------------
        $("#categoryName").val(""); // Text cho rỗng ------------------------

        Swal.fire({
            title: "Đã đặt lại!",
            text: "Trường nhập đã được đặt lại ! ",
            icon: "info",
            confirmButtonText: "OK"
        });
    }

    // ----------------------------------------------------------------------------------------------------------------------------------

</script>
