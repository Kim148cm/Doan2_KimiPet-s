        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Chỉnh sửa thông tin sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <div class="row">
                        <div class="col-xl-6">
                            <img id="editProductImage" src="" alt="Ảnh sản phẩm" class="img-fluid" />
                        </div>
                        <div class="col-xl-6">
                            <!------>
                            <input type="hidden" id="editProductId" />
                            <p id="nameProducts" class="title_sm_pr_cart"></p>
                            <div class="body_sale_modal">
                                <p class="title_modals">FLASH SALE</p>
                            </div>

                            <div class="body_price_modal">
                                <p class="price_main_pr" style="font-weight: 400; color: red;" id="editDisPrice"></p>
