﻿﻿@model List<A25082.Models.GioHang>



<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


@{
    decimal tongTienHang = Model.Sum(x => x.GiaGoc * x.SoLuong);
    decimal voucherDiscount = Session["VoucherDiscount"] != null ? Convert.ToDecimal(Session["VoucherDiscount"]) : 0;
    decimal tamTinh = tongTienHang - voucherDiscount;
    decimal phiVanChuyen = 3000;
    decimal tongThanhToan = tamTinh + phiVanChuyen;
}

<section class="body_part_one_cart">
    <div class="body_two_icon_one">
        <a href="@Url.Action("Index", "Home", new { area = "" })" style="text-decoration:none;"><i class="fa-solid fa-house"></i> Trang chủ</a>
        <span style="font-size: 13px;">|</span>
        <p><i class="fa-solid fa-cart-shopping"></i> Giỏ hàng</p>
        <span style="font-size: 13px;">|</span>
        <a href="@Url.Action("IndexHistory", "PayMent", new { area = "" })" style="text-decoration:none;color:black;"><i class="fa-solid fa-clock"></i> Xem lịch sử mua hàng</a>
    </div>
</section>


<section class="body_part_two_cart body-big-screen">
    <div class="body_all_cart">
        <div class="row row-md">
            <div class="col-xl-7 col-md-one">
                @if (Model != null && Model.Any() && tongThanhToan > 0)
                {
                    <div class="body_two_title_cart">
                        <h4 class="title_h_cart">Giỏ hàng của bạn</h4>
                        <p class="title_sm_cart">(Có <strong>@Model.Count()</strong> sản phẩm trong giỏ hàng)</p>
                    </div>
                }
                <div class="body_pr_cart">

                    @if (Model != null && Model.Any() && tongThanhToan > 0)
                    {
                        <div class="body_small_pr_cart">
                            @foreach (var item in Model)
                            {
                                <div class="row row_body_pr" style="margin-top:1rem;"
                                     data-productid="@item.MaKem"
                                     data-stock="@item.SanPhamKemChongNang?.Stock ?? 0"
                                     data-quantity="@item.SoLuong">

                                    <div class="col-md-3 col-xl-2">
                                        <div class="body_img_cart">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@Url.Content(item.ImageUrl)" alt="Image of @item.TenKem" />
                                            }
                                            else if (item.SanPhamKemChongNang != null && item.SanPhamKemChongNang.AnhKemChongNangs != null && item.SanPhamKemChongNang.AnhKemChongNangs.Any())
                                            {
                                                <img src="@Url.Content(item.SanPhamKemChongNang.AnhKemChongNangs.FirstOrDefault()?.ImageUrl ?? "~/images/default-image.jpg")" alt="Image of @item.TenKem" />
                                            }
                                            else
                                            {
                                                <img src="@Url.Content("~/images/default-image.jpg")" />
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-xl-6">

                                        <h5 class="title_sm_pr_cart"> @(item.TenKem ?? "Tên sản phẩm không có")</h5>

                                        <div class="body_size_color">
                                            <a href="#" data-bs-toggle="modal" data-bs-target="#modal_size"
                                               class="btn-remove" data-productid="@item.MaKem">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        </div>

                                    </div>
                                    <div class="col-md-3 col-xl-2">

                                        <div class="body_edit_ql">
                                            <a href="" class="btn-increase" data-productid="@item.MaKem"><i class="fa-solid fa-plus"></i></a>
                                            <a href="" style="color:black;text-decoration:none;">@item.SoLuong</a>
                                            <a href="" class="btn-decrease" data-productid="@item.MaKem"><i class="fa-solid fa-minus"></i></a>
                                        </div>

                                    </div>
                                    <div class="col-md-3 col-xl-2">
                                        <div class="body_price_pr">
                                            <p class="price_main_pr">@($"{(item.GiaGoc * item.SoLuong):N0} đ")</p>
                                            <p class="price_sale_pr">@item.GiaGoc.ToString("N0")đ</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="text-align:center;font-size:16px;padding:1rem;border:1px solid #e5e5e5;">Giỏ hàng của bạn đang trống.</p>
                    }

                </div>

                <!--------->
                <div class="body_title_left_pay">
                    <p class="title_left_pays" style="color: red;font-weight: bold;margin-top: 2rem;">
                        - Do nhu cầu mua thức ăn và phụ kiện cho thú cưng tăng cao vào một số thời điểm (dịp lễ, khuyến mãi), thời gian giao hàng có thể chậm hơn dự kiến. Mong quý khách thông cảm.
                    </p>

                    <p class="title_left_pays">
                        (*) Vui lòng kiểm tra kỹ sản phẩm thức ăn và phụ kiện thú cưng (bao bì, tem niêm phong, hạn sử dụng đối với thức ăn) trước khi nhận hàng để đảm bảo chất lượng. Trường hợp không kiểm tra, SHOP rất tiếc không thể hỗ trợ đổi/trả.
                    </p>

                    <p class="title_left_pays">
                        (*) Khách hàng có nhu cầu xuất hóa đơn VAT vui lòng liên hệ với SHOP qua Fanpage Facebook ngay sau khi đặt hàng. Thời gian hỗ trợ xuất hóa đơn trong vòng 30 phút kể từ lúc đặt hàng.
                    </p>

                    <p class="title_left_pays">
                        (*) Sản phẩm thức ăn và phụ kiện cho thú cưng có thể được lưu trữ tại nhiều kho khác nhau, vì vậy đơn hàng của Quý khách có thể được giao thành nhiều lần. Mong quý khách thông cảm.
                    </p>

                    <p class="title_left_pays">
                        (*) Khu vực nội thành: thời gian giao hàng dự kiến từ 1 – 3 ngày (trường hợp kho ở tỉnh khác, thời gian giao có thể kéo dài 3 – 4 ngày).
                    </p>

                    <p class="title_left_pays">
                        (*) Khu vực ngoại thành và các tỉnh/thành phố khác: thời gian giao hàng dự kiến từ 3 – 5 ngày.
                    </p>
                </div>





                <div class="body_pr_left_pay">
                    <h4 class="title_h_pr_pay" style="padding-bottom:2rem;">Sản phẩm hay được mua cùng</h4>


                    @Html.Action("CategoryProductLike", "SanPham")

                </div>


            </div>
            <div class="col-xl-5 col-md-two">

                <div class="title_f_pay">
                    <p class="title_pr_right_cart"><u><a href="" style="color: black;font-weight: bold;">Đăng nhập</a></u> để tích điểm và hưởng ưu đãi hạng thành viên từ Kimipet's</p>
                </div>

                <div class="body_cart_info_right">


                    @if (Model != null && Model.Any() && tongThanhToan > 0)
                    {
                        <div class="body_right_pay_cart">
                            <h6 class="title_h_cart" style="font-size: 18px;">TÓM TẮT ĐƠN HÀNG</h6>

                            <div class="body_small_top_pay">
                                <div class="part_sm_pay_right">
                                    <p class="title_pr_right_cart">Tổng tiền hàng : </p>
                                    <p class="title_pr_right_cart">@tongTienHang.ToString("N0")₫</p>
                                </div>                            
                            </div>

                            <div class="body_two_pay_right">
                                <div class="part_sm_pay_right">
                                    <p class="title_pr_right_cart">Tạm tính: </p>
                                    <p class="title_pr_right_cart">@tamTinh.ToString("N0")₫</p>
                                </div>

                                <div class="part_sm_pay_right">
                                    <p class="title_pr_right_cart">Phí vận chuyển : </p>
                                    <p class="title_pr_right_cart">@phiVanChuyen.ToString("N0")₫</p>
                                </div>

                                <div class="part_sm_pay_right">
                                    <p class="title_pr_right_cart">Giảm giá vận chuyển : </p>
                                    <p class="title_pr_right_cart">0đ</p>
                                </div>

                                <div class="part_sm_pay_right">
                                    <p class="title_pay_right_cart">Tổng tiền:</p>
                                    <p class="title_pay_right_cart">@tongThanhToan.ToString("N0")₫</p>
                                </div>
                                <div class="body_all_btn_pay">
                                    <div class="btn_pay_cart">

                                        <a href="@Url.Action("Index", "PayMent", new { totalAmount = tongThanhToan })" class="btn_pay_right" id="btnPlaceOrder" style="text-decoration:none;">
                                            Tiến hành đặt hàng
                                        </a>
                                    </div>

                                    <a href="@Url.Action("Index", "Home")" class="btn_pay_add_right" style="text-decoration:none;">Mua thêm sản phẩm</a>

                                    <p class="dis_title_right" style="margin-top: 1rem;">* Chi tiêu tích lũy được ghi nhận vào tài khoản của bạn khi đơn hàng thành công. Vui lòng đăng nhập để được tích lũy.</p>
                                    <p class="dis_title_right">* Từ ngày 01/01/2026, giá sản phẩm sẽ thay đổi theo quy định điều chỉnh thuế VAT của nhà nước (từ 10% xuống 8%). Mong quý khách hàng thông cảm!</p>
                                </div>

                            </div>
                        </div>
                    }
                 
                    <div class="body_check_pay">

                        <div class="part_check_pay" style="margin-top: 1rem;">
                            <span><i class="fa-solid fa-circle-check"></i></span>
                            <div class="all_title_check">
                                <h5 class="title_h_check">MIỄN PHÍ GIAO HÀNG TOÀN QUỐC</h5>
                                <p class="dis_check">(Cho hoá đơn từ 300.000đ)</p>
                            </div>
                        </div>
                        <div class="part_check_pay">
                            <span><i class="fa-solid fa-circle-check"></i></span>
                            <div class="all_title_check">
                                <h5 class="title_h_check">ĐỔI TRẢ DỄ DÀNG</h5>
                                <p class="dis_check">(Đổi trả ngay khi sản phẩm kem có hư hại)</p>
                            </div>
                        </div>
                        <div class="part_check_pay">
                            <span><i class="fa-solid fa-circle-check"></i></span>
                            <div class="all_title_check">
                                <h5 class="title_h_check">TỔNG ĐÀI BÁN HÀNG 1122 1122</h5>
                                <p class="dis_check">(Miễn phí từ 8:00 - 21:00 mỗi ngày)</p>
                            </div>
                        </div>
                    </div>

                </div>




            </div>
        </div>
    </div>
</section>




<!-------------------------------------------------------------------------------------------------------------------------------------------->
<!-- Modal Voucher ------------------------------------------------------------------------------------------------------------------------------>
<div class="modal fade" id="voucherModal" tabindex="-1" aria-labelledby="voucherModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="voucherModalLabel">CHỌN VOUCHER</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Body -->
            <div class="modal-body">
                <!-- Input nhập voucher -->
                <div class="input-group mb-3">
                    <input type="text" class="form-control" id="voucherCode" placeholder="Nhập Mã Ưu Đãi">
                    <button class="btn btn-dark" id="applyVoucher">Áp Dụng</button>
                </div>

                <!-- DANH SÁCH VOUCHER -->
                <h6 class="text-uppercase fw-bold">Voucher Có Sẵn</h6>
                <div class="body_all_vouchers" style="height:480px;overflow-y:scroll;overflow-x:hidden;">
                    <div id="voucherList"></div>
                </div>
            </div>
            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-dark w-100" id="confirmVoucher">ĐỒNG Ý</button>
            </div>
        </div>
    </div>
</div>

