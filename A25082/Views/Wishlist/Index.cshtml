


@model List<A25082.Models.SanPhamKemChongNang>
@using A25082.Models
@{
    ViewBag.Title = "Sản phẩm yêu thích | Kimipet's";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ids = ViewBag.WishlistIds as List<int> ?? new List<int>();
    int total = Model?.Count ?? 0;
}
@section ScriptsProduct{
    <script src="~/Assets/js/Detail.js"></script>
}
<style>
    :root {
        --green: #1a7a3c;
        --green-lt: #f0faf4;
        --green-md: #e0f2e9;
        --border: #e5e5e5;
        --text: #1a1a1a;
        --text2: #555;
        --text3: #999;
        --white: #fff;
        --bg: #f7f7f7;
        --red: #e53935;
        --radius: 10px;
        --font: 'Nunito', sans-serif;
    }

    .wl-page {
        font-family: var(--font);
        background: var(--bg);
        min-height: 60vh;
    }

    /* ── Header strip ── */
    .wl-header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 22px 0;
    }

    .wl-header-inner {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .wl-breadcrumb {
        font-size: 12.5px;
        color: var(--text3);
        margin-bottom: 4px;
    }

        .wl-breadcrumb a {
            color: var(--text3);
            text-decoration: none;
        }

            .wl-breadcrumb a:hover {
                color: var(--green);
            }

        .wl-breadcrumb span {
            margin: 0 6px;
        }

    .wl-title {
        font-size: 22px;
        font-weight: 800;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .wl-title-count {
        font-size: 13px;
        font-weight: 600;
        color: var(--text3);
        background: var(--bg);
        border: 1px solid var(--border);
        padding: 3px 12px;
        border-radius: 20px;
    }

    .wl-btn-clear {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        color: var(--text2);
        background: var(--white);
        cursor: pointer;
        font-family: var(--font);
        transition: all .18s;
    }

        .wl-btn-clear:hover {
            border-color: var(--red);
            color: var(--red);
            background: #fff8f8;
        }

    /* ── Body ── */
    .wl-body {
        max-width: 1300px;
        margin: 0 auto;
        padding: 28px 24px 60px;
    }

    /* ── Grid ── */
    .wl-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 18px;
    }

    /* ── Card ── */
    .wl-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
        transition: box-shadow .22s, transform .22s;
        animation: wlFade .35s ease both;
    }

    @@keyframes wlFade {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .wl-card:hover {
        box-shadow: 0 8px 28px rgba(0,0,0,.09);
        transform: translateY(-3px);
    }

    /* Removing animation */
    .wl-card.removing {
        animation: wlRemove .3s ease forwards;
    }

    @@keyframes wlRemove {
        to {
            opacity: 0;
            transform: scale(.94);
        }
    }

    /* Image */
    .wl-img {
        position: relative;
        padding-top: 100%;
        overflow: hidden;
        background: var(--bg);
    }

        .wl-img img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s;
        }

    .wl-card:hover .wl-img img {
        transform: scale(1.04);
    }

    /* Badge */
    .wl-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        font-size: 10.5px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 4px;
        z-index: 2;
    }

        .wl-badge.sale {
            background: var(--red);
            color: #fff;
        }

        .wl-badge.new {
            background: var(--green);
            color: #fff;
        }

    /* Remove button */
    .wl-remove {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        color: var(--text3);
        cursor: pointer;
        z-index: 2;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
        transition: all .18s;
    }

        .wl-remove:hover {
            color: var(--red);
            border-color: var(--red);
            background: #fff8f8;
        }

    /* Card body */
    .wl-card-body {
        padding: 12px 14px 14px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .wl-cat {
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: var(--green);
    }

    .wl-name {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.4;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

        .wl-name:hover {
            color: var(--green);
        }

    .wl-stars {
        display: flex;
        gap: 2px;
        font-size: 11px;
        color: #f5c518;
    }

    .wl-prices {
        display: flex;
        align-items: baseline;
        gap: 7px;
        flex-wrap: wrap;
        margin-top: 2px;
    }

    .wl-price-main {
        font-size: 15px;
        font-weight: 800;
        color: var(--green);
    }

    .wl-price-orig {
        font-size: 12px;
        color: var(--text3);
        text-decoration: line-through;
    }

    .wl-price-save {
        font-size: 10.5px;
        font-weight: 700;
        color: var(--red);
        background: #fef2f2;
        padding: 2px 6px;
        border-radius: 4px;
    }

    /* Buttons row */
    .wl-actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
    }

    .wl-btn-cart {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 9px 10px;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
        font-family: var(--font);
        transition: opacity .18s;
    }

        .wl-btn-cart:hover {
            opacity: .88;
        }

        .wl-btn-cart:disabled {
            background: #e5e5e5;
            color: var(--text3);
            cursor: not-allowed;
            opacity: 1;
        }

    .wl-btn-detail {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text2);
        text-decoration: none;
        font-size: 14px;
        flex-shrink: 0;
        transition: all .18s;
    }

        .wl-btn-detail:hover {
            border-color: var(--green);
            color: var(--green);
            background: var(--green-lt);
        }

    /* ── Empty state ── */
    .wl-empty {
        text-align: center;
        padding: 90px 20px;
        color: var(--text3);
        font-family: var(--font);
    }

    .wl-empty-icon {
        font-size: 56px;
        opacity: .18;
        display: block;
        margin-bottom: 16px;
    }

    .wl-empty h2 {
        font-size: 18px;
        font-weight: 800;
        color: var(--text2);
        margin-bottom: 8px;
    }

    .wl-empty p {
        font-size: 13.5px;
        margin-bottom: 20px;
    }

    .wl-empty-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--green);
        color: #fff;
        padding: 11px 24px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 13.5px;
        text-decoration: none;
        transition: opacity .18s;
        font-family: var(--font);
    }

        .wl-empty-btn:hover {
            opacity: .88;
            color: #fff;
        }

    /* ── Toast notification ── */
    .wl-toast {
        position: fixed;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        background: var(--text);
        color: #fff;
        padding: 11px 22px;
        border-radius: 8px;
        font-size: 13.5px;
        font-weight: 600;
        font-family: var(--font);
        box-shadow: 0 4px 20px rgba(0,0,0,.2);
        z-index: 9999;
        opacity: 0;
        transition: opacity .25s, transform .25s;
        pointer-events: none;
        white-space: nowrap;
    }

        .wl-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

    /* ── Counter badge in header nav ── */
    #wl-nav-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        background: var(--red);
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        border-radius: 10px;
        padding: 0 4px;
        margin-left: 4px;
        vertical-align: middle;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .wl-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
        }

        .wl-body {
            padding: 16px 16px 48px;
        }

        .wl-header-inner {
            padding: 0 16px;
        }

        .wl-title {
            font-size: 18px;
        }
    }

    @@media (max-width: 480px) {
        .wl-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
    }
</style>

<div class="wl-page">


    <div class="wl-header">
        <div class="wl-header-inner">
            <div>
                <div class="wl-breadcrumb">
                    <a href="@Url.Action("Index","Home")">Trang chủ</a>
                    <span>›</span> Yêu thích
                </div>
                <div class="wl-title">
                    <i class="fa-solid fa-heart" style="color:var(--red);font-size:20px;"></i>
                    Sản phẩm yêu thích
                    <span class="wl-title-count" id="wlTotalCount">@total sản phẩm</span>
                </div>
            </div>

            @if (total > 0)
            {
                <button class="wl-btn-clear" onclick="wlClearAll()">
                    <i class="fa-regular fa-trash-can"></i> Xoá tất cả
                </button>
            }
        </div>
    </div>


    <div class="wl-body">

        @if (Model != null && Model.Any())
        {
            <div class="wl-grid" id="wlGrid">
                @foreach (var p in Model)
                {
                    decimal giaGoc = p.GiaGoc < 1000 ? p.GiaGoc * 1000 : p.GiaGoc;
                    decimal giaGiam = p.GiaGiam < 1000 ? p.GiaGiam * 1000 : p.GiaGiam;

                    bool hasSale = giaGiam > 0 && giaGiam < giaGoc;
                    int pct = 0;

                    if (hasSale && giaGoc > 0)
                    {
                        pct = (int)Math.Round((1.0 - (double)giaGiam / (double)giaGoc) * 100);
                        // Chặn badge vô lý: chỉ hiện nếu giảm từ 1% đến 70%
                        if (pct <= 0 || pct > 70) { hasSale = false; pct = 0; }
                    }

                    decimal price = hasSale ? giaGiam : giaGoc;
                    string img = p.AnhKemChongNangs != null && p.AnhKemChongNangs.Any()
                                      ? p.AnhKemChongNangs.First().ImageUrl
                                      : "/Assets/img/no-image.png";
                    bool sold = p.SoLuongTon <= 0;
                    string dUrl = "/SanPham/PageDeTailsProduct/" + p.MaKem;

                    <div class="wl-card" id="wl-card-@p.MaKem">
                        <div class="wl-img">
                            <a href="@dUrl">
                                <img src="@img" alt="@p.TenKem" loading="lazy" />
                            </a>

                            @if (hasSale)
                            {<span class="wl-badge sale">-@pct%</span> }
                        else if (p.MaKem % 5 == 0)
                        { <span class="wl-badge new">Mới</span>}

                            <button class="wl-remove" onclick="wlRemove(@p.MaKem, this)" title="Xoá khỏi yêu thích">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <div class="wl-card-body">
                            @if (p.LoaiKemChongNang != null)
                            {
                                <div class="wl-cat">@p.LoaiKemChongNang.TenLoai</div>
                            }

                            <a href="@dUrl" class="wl-name">@p.TenKem</a>

                            <div class="wl-stars">
                                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                                <i class="fa-regular fa-star"></i>
                            </div>

                            <div class="wl-prices">
                                <span class="wl-price-main">@price.ToString("N0")đ</span>
                                @if (hasSale)
                                {
                                    <span class="wl-price-orig">@giaGoc.ToString("N0")đ</span>
                                    <span class="wl-price-save">-@((giaGoc - giaGiam).ToString("N0"))đ</span>
                                }
                            </div>

                            <div class="wl-actions">
                                @if (!sold)
                                {
                                  
                                }
                                else
                                {
                                    <button class="wl-btn-cart" disabled>Hết hàng</button>
                                }
                                <a href="@dUrl" class="wl-btn-detail" title="Xem chi tiết">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="wl-empty" id="wlEmpty">
                <i class="fa-regular fa-heart wl-empty-icon"></i>
                <h2>Chưa có sản phẩm yêu thích</h2>
                <p>Nhấn vào biểu tượng ♡ trên sản phẩm để lưu vào danh sách yêu thích của bạn.</p>
                <a href="@Url.Action("AllProduct","SanPham")" class="wl-empty-btn">
                    <i class="fa-solid fa-store"></i> Khám phá sản phẩm
                </a>
            </div>
        }

    </div>
</div>


<div class="wl-toast" id="wlToast"></div>


@section ScriptDetails{
    <script src="~/Assets/js/LikeProduct.js"></script>
}
@section ScriptsProducts {
    <script>
        // ── Toast helper ──────────────────────────────────────────────
        function wlShowToast(msg) {
            var t = document.getElementById('wlToast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(function () { t.classList.remove('show'); }, 2200);
        }

        // ── Xoá 1 sản phẩm ───────────────────────────────────────────
        function wlRemove(productId, btn) {
            var card = document.getElementById('wl-card-' + productId);
            if (!card) return;

            card.classList.add('removing');

            fetch('/Wishlist/Remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=&productId=' + productId
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        setTimeout(function () {
                            card.remove();
                            updateCount(data.count);

                            // Kiểm tra còn sản phẩm không
                            var grid = document.getElementById('wlGrid');
                            if (grid && grid.children.length === 0) showEmptyState();
                        }, 300);
                        // Sync nút tim trên các trang khác nếu có
                        wlSyncButtons(productId, false);
                        wlShowToast('Đã xoá khỏi yêu thích');
                    }
                })
                .catch(function () { card.classList.remove('removing'); });
        }

        // ── Xoá tất cả ───────────────────────────────────────────────
        function wlClearAll() {
            if (!confirm('Bạn có chắc muốn xoá tất cả sản phẩm yêu thích?')) return;

            fetch('/Wishlist/ClearAll', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken='
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        var grid = document.getElementById('wlGrid');
                        if (grid) grid.remove();
                        showEmptyState();
                        updateCount(0);
                        wlShowToast('Đã xoá tất cả sản phẩm yêu thích');

                        // Ẩn nút xoá tất cả
                        var clearBtn = document.querySelector('.wl-btn-clear');
                        if (clearBtn) clearBtn.style.display = 'none';
                    }
                });
        }

        // ── Hiện trạng thái rỗng ─────────────────────────────────────
        function showEmptyState() {
            var body = document.querySelector('.wl-body');
            if (!body) return;
            body.innerHTML =
                '<div class="wl-empty" id="wlEmpty">' +
                '  <i class="fa-regular fa-heart wl-empty-icon"></i>' +
                '  <h2>Chưa có sản phẩm yêu thích</h2>' +
                '  <p>Nhấn vào biểu tượng ♡ trên sản phẩm để lưu vào danh sách yêu thích.</p>' +
                '  <a href="/SanPham/AllProduct" class="wl-empty-btn">' +
                '    <i class="fa-solid fa-store"></i> Khám phá sản phẩm' +
                '  </a>' +
                '</div>';
        }

        // ── Cập nhật badge số lượng ───────────────────────────────────
        function updateCount(n) {
            // Tiêu đề trang
            var tc = document.getElementById('wlTotalCount');
            if (tc) tc.textContent = n + ' sản phẩm';

            // Badge trên nav header
            wlUpdateNavBadge(n);
        }

        // ── Sync nút tim (cho các trang dùng chung wishlist.js) ───────
        function wlSyncButtons(productId, active) {
            document.querySelectorAll('[data-wl-id="' + productId + '"]').forEach(function (btn) {
                if (active) {
                    btn.classList.add('active');
                    var i = btn.querySelector('i');
                    if (i) i.className = 'fa-solid fa-heart';
                } else {
                    btn.classList.remove('active');
                    var i = btn.querySelector('i');
                    if (i) i.className = 'fa-regular fa-heart';
                }
            });
        }

        // ── Cập nhật badge nav ────────────────────────────────────────
        function wlUpdateNavBadge(count) {
            var badge = document.getElementById('wl-nav-count');
            if (!badge) return;
            badge.textContent = count;
            badge.style.display = count > 0 ? 'inline-flex' : 'none';
        }



    </script>
}


