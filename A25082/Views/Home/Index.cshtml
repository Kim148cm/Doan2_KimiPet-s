<script>
    AOS.init({
        once: false,
        duration: 600,
        offset: 200,
        mirror: true
    });

    $(document).ready(function () {
        var firstCatId = $("#categoryTab .nav-link.active").data("id");
        if (firstCatId !== undefined) {
            loadProducts(firstCatId);
        }

        $("#categoryTab").on("click", ".nav-link", function (e) {
            e.preventDefault();
            $("#categoryTab .nav-link").removeClass("active");
            $(this).addClass("active");
            var catId = $(this).data("id");
            loadProducts(catId);
        });

        function loadProducts(categoryId) {
            $.get("/CategoryProduct/ProductsByCategory", { categoryId: categoryId }, function (data) {
                $("#category-products").html(data);
            });
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        const viewAllLink = document.getElementById("viewAllLink");
        const categoryTabs = document.querySelectorAll(".category-tab");

        categoryTabs.forEach(tab => {
            tab.addEventListener("click", function () {
                const categoryId = this.getAttribute("data-id");

                // Cập nhật nút XEM TẤT CẢ
                viewAllLink.href = `/SanPham/AllProductsByCategory?categoryId=${categoryId}`;

                // Cập nhật trạng thái active
                categoryTabs.forEach(t => t.classList.remove("active"));
                this.classList.add("active");

                // TODO: Nếu muốn load sản phẩm theo tab khi click
                // gọi Ajax hoặc reload nội dung sản phẩm ở đây
            });
        });
    });

   

</script>
