<section class="body_all_six">
    <h4 class="title_ele_six">DANH SÁCH CÁC LOẠI MỚI</h4>
    <!---- sản phẩm theo loại -->
    <div class="category-tabs" style="display:flex;justify-content:space-between;align-items:center;margin-top:4rem;">
        <ul class="nav nav-tabs" id="categoryTab">
            @if (Model.LoaiKemChongNangs != null && Model.LoaiKemChongNangs.Any())
            {
                var firstCatId = Model.LoaiKemChongNangs.First().MaLoai;
                foreach (var cat in Model.LoaiKemChongNangs)
                {
                    <li class="nav-item">
                        <a class="nav-link category-tab @(firstCatId == cat.MaLoai ? "active" : "")"
                           data-id="@cat.MaLoai"
                           href="javascript:void(0);"
                           style="font-size:14px;">
                            @cat.TenLoai
                        </a>
                    </li>
                }
            }
            else
            {
                <li class="nav-item">
                    <span class="nav-link text-muted">Không có loại sản phẩm nào</span>
                </li>
            }


        </ul>
        <div class="view-all-btn">
            <a id="viewAllLink"
               href="@Url.Action("AllProductsByCategory", "SanPham", new { categoryId = Model.LoaiKemChongNangs.First().MaLoai })"
               class="btn-view-all">
                XEM TẤT CẢ <i class="fas fa-arrow-right" style="margin-left:8px;"></i>
            </a>
        </div>
    </div>

    <div id="category-products" style="margin-top:20px;">
        <!-- Sản phẩm load qua AJAX -->
    </div>

</section>

