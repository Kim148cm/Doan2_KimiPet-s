<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop Kimipet's' - Trang chính</title>

    <!------css ,js -->
    <link href="~/Assets/css/phone.css" rel="stylesheet" />
    <link href="~/Assets/css/Header.css" rel="stylesheet" />
    <link href="~/Assets/css/PageDetail.css" rel="stylesheet" />
    <link href="~/Assets/css/PageClotherSale.css" rel="stylesheet" />
    <link href="~/Assets/css/PageLogin.css" rel="stylesheet" />
    <link href="~/Assets/css/PageSanPham.css" rel="stylesheet" />
    <link href="~/Assets/css/PageShowRoom.css" rel="stylesheet" />
    <link href="~/Assets/css/StyleSheet.css" rel="stylesheet" />
    <link href="~/Assets/css/GioHang.css" rel="stylesheet" />
    <link href="~/Assets/css/PayMentCart.css" rel="stylesheet" />
    <link href="~/Assets/css/ProductCategory.css" rel="stylesheet" />
    <link href="~/Assets/css/ai.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/Assets/img/iconshop.png" sizes="64x64"/>
    <link href="~/Assets/css/slider.css" rel="stylesheet" />
    <!---Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!---icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!--- Swipeer -->
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

    <!---- Thông báo SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    @Scripts.Render("~/bundles/js")
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <style>
        .custom-swal {
            z-index: 9999 !important;
            left: 10px !important;
            top: 10px !important;
        }

        .bg_img_r {
            width: 100%;
            height: auto;
        }

            .bg_img_r img {
                width: 100%;
                height: auto;
            }

        .find_input {
            width: 200px;
            height: 40px;
            border: 1px solid #e5e5e5;
            border-radius: 10px;
            padding-inline: 1rem;
        }

        .sidebar_right {
            position: fixed;
            top: 0;
            right: -500px; /* Ẩn sidebar mặc định */
            width: 500px;
            height: 100%;
            background-color: #fff;
            transition: right 0.3s ease-in-out;
            z-index: 9999;
            box-shadow: -4px 0 10px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
        }

            .sidebar_right.open {
                right: 0; /* Khi mở thì hiển thị ra */
            }

        #overlay {
            display: none; /* Ẩn lớp phủ mặc định */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9998;
        }

            #overlay.active {
                display: block; /* Hiển thị lớp phủ */
            }


        .sidebar_right.open {
            right: 0;
        }

        .body_pr_sidebar_r {
            padding: 1rem 0;
            height: 500px;
            overflow-y: scroll;
            overflow-x: hidden;
        }
        /** nút liên hệ ***/
        .echbay-sms-messenger div.phonering-alo-zalo,
        .echbay-sms-messenger div.phonering-alo-alo {
            background-color: #0084ff
        }

        .echbay-sms-messenger div.phonering-alo-sms {
            background-color: #f60
        }

        .echbay-sms-messenger div.phonering-alo-messenger {
            background-color: #e60f1e
        }

        .echbay-sms-messenger {
            width: 45px
        }

            .echbay-sms-messenger a {
                line-height: 45px;
                color: transparent;
                display: block;
            }

        .echbay-sms-messenger {
            display: block
        }

            .echbay-sms-messenger div.phonering-alo-zalo {
                display: block
            }

            .echbay-sms-messenger div.phonering-alo-alo {
                background-image: url(https://codfe.com/wp-content/uploads/2020/08/call.png);
            }

            .echbay-sms-messenger div.phonering-alo-sms {
                background-image: url(https://codfe.com/wp-content/uploads/2020/08/mail.png);
                background-color: #f60;
                background-size: 60%;
            }

            .echbay-sms-messenger div.phonering-alo-zalo {
                background-image: url(https://codfe.com/wp-content/uploads/2020/08/zalo.png);
            }

            .echbay-sms-messenger div.phonering-alo-messenger {
                background-image: url(https://codfe.com/wp-content/uploads/2020/08/messenger.png);
                background-color: #e60f1e;
            }

            .echbay-sms-messenger div {
                margin: 14px 0;
                background: #0084FF center no-repeat;
                background-size: 70%;
                border-radius: 50%;
                box-shadow: 0 3px 10px #888;
            }

        .echbay-sms-messenger {
            text-align: center;
            right: 20px;
            position: fixed;
            bottom: 140px;
            z-index: 999;
        }

        /**** code thông báo sản phẩm khi gõ từ khóa tìm kiếm */
        .price-text {
            color: red;
            font-weight: bold;
        }

        #suggestion-list {
            position: absolute;
            left: -30%;
            width: 420px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-shadow: 0px 5px 10px rgba(0, 0, 0, 0.2);
            max-height: 400px;
            overflow-y: auto;
            padding: 1rem;
            margin: 0;
            list-style: none;
            z-index: 1000;
            display: none;
        }

            #suggestion-list li {
                padding: 10px;
                cursor: pointer;
                border-bottom: 1px solid #eee;
            }

                #suggestion-list li:hover {
                    background: #f7f7f7;
                }
    </style>
    <!--- sản phẩm hot -->
    <!-----Nút liên hệ -->
    <div class="echbay-sms-messenger style-for-position-br">
        <div class="phonering-alo-alo">
            <a href="tel:0384533724" rel="nofollow" class="echbay-phonering-alo-event">.</a>
        </div>
        <div class="phonering-alo-zalo">
            <a href="" target="_blank" rel="nofollow" class="echbay-phonering-zalo-event">.</a>
        </div>
        <div class="phonering-alo-messenger">
            <a href="" target="_blank" rel="nofollow" class="echbay-phonering-messenger-event">.</a>
        </div>
    </div>



    <div class="topbar-kimipet">
        Giảm đến <strong>50% OFF</strong> cho thành viên Kimipet's ·
        <a href="@Url.Action("Index", "DangNhapNguoiDung")">Đăng ký ngay!</a>
    </div>

    <!-- ═══ MAIN HEADER ═══ -->
    <header class="header-kimipet" id="header-kimipet">

        <!-- ── Top row: Logo · Search · Actions ── -->
        <div class="header-top-row">

            <!-- LOGO (dùng Url.Action, KHÔNG dùng Html.ActionLink để tránh lỗi linkText rỗng) -->
            <a href="@Url.Action("Index", "Home", new { area = "" })" class="header-logo">
                <span class="logo-badge">Kimi<span>pet's</span></span>
            </a>

            <!-- SEARCH -->
            <div class="header-search">
                <form id="searchForm" action="/Search/Index" method="GET">
                    <input type="text"
                           class="header-search-input"
                           name="query"
                           id="searchInput"
                           placeholder="Tìm thức ăn, phụ kiện thú cưng..."
                           autocomplete="off" />
                    <button type="submit" class="header-search-btn">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </form>
                <ul id="suggestion-list"></ul>
            </div>

            <!-- ACTIONS -->
            <div class="header-actions">

                <!-- Hotline -->
                <div class="header-action-item d-none d-xl-flex" style="flex-direction:row;gap:8px;align-items:center;">
                    <i class="fa-solid fa-phone-volume" style="font-size:20px;"></i>
                    <span style="font-size:12px;line-height:1.3;">
                        Hotline<br>
                        <strong style="color:var(--primary,#1a7a3c);font-size:13px;">039 4627 246</strong>
                    </span>
                </div>

                <a href="@Url.Action("Index","Wishlist")" class="header-action-item">
                    <i class="fa-regular fa-heart"></i>
                    <span>
                        Yêu thích
                        <span id="wl-nav-count" style="
                   display:none;
                   background:#e53935; color:#fff;
                   font-size:10px; font-weight:800;
                   min-width:18px; height:18px;
                   border-radius:10px; padding:0 4px;
                   margin-left:3px; vertical-align:middle;
                   align-items:center; justify-content:center;
               ">0</span>
                    </span>
                </a>


                <!-- User / Đăng nhập -->
                @if (Session["User"] != null)
                {
                    var user = (A25082.Models.NguoiDung)Session["User"];
                    <div class="header-action-item dropdown">
                        <div class="dropdown-toggle"
                             data-bs-toggle="dropdown"
                             id="userDropBtn"
                             style="display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;">
                            <i class="fa-solid fa-circle-user" style="font-size:22px;"></i>
                            <span style="font-size:11.5px;font-weight:600;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @user.TenDangNhap
                            </span>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropBtn">
                            @if (user.MaVaiTro == 1)
                            {
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("ManHinhChinhAdmin", "HomeAdmin", new { area = "" })">
                                        <i class="fas fa-tools me-2"></i>Quản trị Admin
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <a class="dropdown-item text-danger" href="@Url.Action("DangXuat", "DangNhapNguoiDung", new { area = "" })">
                                    <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Index", "DangNhapNguoiDung", new { area = "" })" class="header-action-item">
                        <i class="fa-regular fa-user"></i>
                        <span>Đăng nhập</span>
                    </a>
                }

                <!-- Giỏ hàng -->
                @{
                    var cart = Session["Cart"] as List<A25082.Models.GioHang> ?? new List<A25082.Models.GioHang>();
                    int totalQuantity = cart.Sum(c => c.SoLuong);
                }
                <div class="header-action-item" onclick="SidebarRight(true)" style="cursor:pointer;position:relative;">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Giỏ hàng</span>
                    <span class="badge"
                          id="cart-count-main"
                          style="@(totalQuantity > 0 ? "" : "display:none")">
                        @totalQuantity
                    </span>
                </div>

            </div>
        </div>

        <!-- ── NAV CATEGORIES ── -->
        <nav class="header-nav">
            <ul class="nav-categories">

                <li class="nav-cat-item">
                    <a href="@Url.Action("Index", "Home", new { area = "" })" class="nav-cat-link">
                        <i class="fa-solid fa-house"></i> Trang Chủ
                    </a>
                </li>

                <li class="nav-cat-item">
                    <a href="@Url.Action("AllProductsByCategoryPET", "SanPham", new { categoryId = 2 })" class="nav-cat-link">
                        <i class="fa-solid fa-dog"></i> Chó
                    </a>
                    <div class="mega-menu">
                        <a href="@Url.Action("AllProductsByCategoryPET", "SanPham", new { categoryId = 2 })" class="mega-menu-item">
                            <div class="cat-icon"><i class="fa-solid fa-bone" style="color:var(--primary,#1a7a3c)"></i></div>
                            Thức ăn cho chó
                        </a>
                        <div class="mega-menu-divider"></div>
                        <a href="@Url.Action("AllProductsByCategoryPET", "SanPham", new { categoryId = 6 })" class="mega-menu-item">
                            <div class="cat-icon"><i class="fa-solid fa-cookie-bite" style="color:var(--primary,#1a7a3c)"></i></div>
                            Snack cho chó
                        </a>
                    </div>
                </li>

                <li class="nav-cat-item">
                    <a href="@Url.Action("AllProductsByCategoryPET", "SanPham", new { categoryId = 1 })" class="nav-cat-link">
                        <i class="fa-solid fa-cat"></i> Mèo
                    </a>
                    <div class="mega-menu">
                        <a href="@Url.Action("AllProductsByCategoryPET", "SanPham", new { categoryId = 1 })" class="mega-menu-item">
                            <div class="cat-icon"><i class="fa-solid fa-fish" style="color:var(--primary,#1a7a3c)"></i></div>
                            Thức ăn cho mèo
                        </a>
                        <div class="mega-menu-divider"></div>
                        <a href="@Url.Action("AllProductsByCategoryPET", "SanPham", new { categoryId = 7 })" class="mega-menu-item">
                            <div class="cat-icon"><i class="fa-solid fa-cookie" style="color:var(--primary,#1a7a3c)"></i></div>
                            Snack cho mèo
                        </a>
                    </div>
                </li>

                <li class="nav-cat-item">
                    <a href="@Url.Action("AllProduct", "SanPham", new { area = "" })" class="nav-cat-link">
                        <i class="fa-solid fa-border-all"></i> Tất cả sản phẩm
                    </a>
                </li>

                <li class="nav-cat-item">
                    <a href="@Url.Action("AllDiscountProducts", "SanPham", new { area = "" })" class="nav-cat-link">
                        <i class="fa-solid fa-tags"></i> Khuyến mãi
                    </a>
                </li>

                <li class="nav-cat-item">
                    <a href="@Url.Action("DanhGia", "DangNhapNguoiDung", new { area = "" })" class="nav-cat-link">
                        <i class="fa-solid fa-star"></i> Đánh giá
                    </a>
                </li>
                <li class="nav-cat-item">
                    <a href="@Url.Action("DatLich", "Spa", new { area = "" })" class="nav-cat-link">
                        <i class="fa-solid fa-scissors"></i> Spa thú cưng
                    </a>
                    <div class="mega-menu">
                        <a href="@Url.Action("DatLich", "Spa", new { area = "" })" class="mega-menu-item">
                            <div class="cat-icon"><i class="fa-solid fa-calendar-plus" style="color:var(--primary,#1a7a3c)"></i></div>
                            Đặt lịch ngay
                        </a>
                        <div class="mega-menu-divider"></div>
                        <a href="@Url.Action("DichVu", "Spa", new { area = "" })" class="mega-menu-item">
                            <div class="cat-icon"><i class="fa-solid fa-list-check" style="color:var(--primary,#1a7a3c)"></i></div>
                            Dịch vụ & Bảng giá
                        </a>
                        <div class="mega-menu-divider"></div>
                        @if (Session["User"] != null)
                        {
                            <a href="@Url.Action("LichSuDatLich", "Spa", new { area = "" })" class="mega-menu-item">
                                <div class="cat-icon"><i class="fa-solid fa-clock-rotate-left" style="color:var(--primary,#1a7a3c)"></i></div>
                                Lịch hẹn của tôi
                            </a>
                        }
                    </div>
                </li>

            </ul>
        </nav>

    </header>



    <!-- Sidebar - right  - Lagre  -->
    <!--------------------------------------- side bar hiển thị sản phẩm khi thêm vào giỏ hàng ----------------------------------------------->
    <div class="sidebar_right" id="sidebar_right">
        <span class="close-btn_right" onclick="SidebarRight(false)">&times;</span>
        <div class="body_sidebar_right">

            <div class="body_title_sidebar_r">
                <h4 class="title_ten">GIỎ HÀNG</h4>
                <p class="title_small_ten">Bạn đang có <span id="cart_count">@ViewBag.TotalItems</span> sản phẩm trong giỏ hàng.</p>
            </div>

            <div class="body_pr_sidebar_r">
                @Html.Partial("_CartSidebarPartial", Session["Cart"] as List<A25082.Models.GioHang> ?? new List<A25082.Models.GioHang>())

            </div>


            <div class="body_pr_pay">
                <div class="link_cart">
                    <a href="@Url.Action("Index", "GioHang", new { area = "" })" class="btn_pay_r">
                        <i class="fas fa-shopping-cart" style="margin-right:8px;"></i> XEM GIỎ HÀNG
                    </a>
                </div>
            </div>

        </div>
    </div>
    <div class="overlay" id="overlay"></div>


    <!----------------------------------------------------------------------------------------------------------------------------------------->
    <!--------- Main body ---------->


    @RenderBody()
    <!------------------------------->
    <!-------------------------------------  FOOTER ---------------------------------------------------->
    <!-------- body part ten -->
    <section class="body_all_ten">
        <div class="product_sv">
            <div class="row">

                <div class="col-xl-4 product_sm_six">
                    <div class="body_title_sm_ten">
                        <h4 class="title_ten">GỌI ĐẶT HÀNG ONLINE (08:00 - 23: 00 mỗi ngày)</h4>
                        <h3 class="title_big_ten">039 4627 246</h3>
                        <h6 class="title_small_ten">Tất cả các ngày trong tuần (Trừ tết Âm Lịch) </h6>
                    </div>

                    <div class="body_title_sm_ten" style="margin-top: 2rem;">
                        <h4 class="title_ten">GÓP Ý & KHIẾU NẠI (08:30 - 20:30)</h4>
                        <h3 class="title_big_ten">039 4627 246</h3>
                        <h6 class="title_small_ten">Tất cả các ngày trong tuần (Trừ tết Âm Lịch) </h6>
                    </div>
                </div>

                <div class="col-xl-4 product_sm_six product_ten_phone">
                    <h4 class="title_ten">HỆ THỐNG CỬA HÀNG</h4>
                    <div class="img_six">
                        <img src="~/Assets/img/cuahang.jpg" />
                    </div>

                </div>

                <div class="col-xl-4 product_sm_six product_ten_phone">
                    <h4 class="title_ten">FANPAGE CỦA CHÚNG TÔI</h4>
                    <div class="img_six">
                        <img src="~/Assets/img/banner2.jpg" />
                    </div>
                    <div class="ten_social_sm">
                        <i class="fa-brands fa-tiktok"></i>
                        <i class="fa-brands fa-facebook"></i>
                        <i class="fa-brands fa-instagram"></i>
                    </div>
                </div>

            </div>
        </div>

    </section>




    <!---------------->


    <section class="body_all_ten">
        <div class="body_all_finally" style="padding:2rem 0;">
            <h4 class="title_ten title_final_phone" style="font-size: 14px;">CÔNG TY CỔ PHẦN KINH DOANH KIMIPET'S'</h4>
        </div>
    </section>

    <div class="modal fade" id="welcomeModal" tabindex="-1" aria-labelledby="welcomeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">THÔNG TIN KHUYẾN MÃI </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <img src="~/Assets/img/anh2.jpg" alt="Banner" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>

    <!-- Floating AI Chatbot---------------------------------------------------------------------------------------- -->
    <div id="chatbot-container">
        <div id="chatbot-header">
            <img src="https://cdn-icons-png.flaticon.com/512/8943/8943377.png" alt="AI" />
            <div class="chatbot-header-info">
                <div class="bot-name">Trợ lý Kimipet's 🐾</div>
                <div class="bot-status">
                    <span class="status-dot"></span> Đang hoạt động
                </div>
            </div>
            <button id="chatbot-close">&times;</button>
        </div>

        <div id="chatbot-quick-suggestions">
            <span class="quick-chip" onclick="sendQuick(this)">🐶 Thức ăn chó</span>
            <span class="quick-chip" onclick="sendQuick(this)">🐱 Thức ăn mèo</span>
            <span class="quick-chip" onclick="sendQuick(this)">🏷️ Khuyến mãi</span>
            <span class="quick-chip" onclick="sendQuick(this)">📦 Sản phẩm mới</span>
        </div>

        <div id="chatbot-messages"></div>

        <div id="chatbot-input-area">
            <input type="text" id="chatbot-input" placeholder="Nhập tin nhắn..." autocomplete="off" />
            <button id="chatbot-send">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>
    </div>

    <div id="chatbot-toggle">
        <img src="~/Assets/img/robot.gif" alt="AI" class="ai-avatar" />
    </div>
    <div class="hotline-phone-ring-wrap">
        <div class="hotline-phone-ring">
            <div class="hotline-phone-ring-circle"></div>
            <div class="hotline-phone-ring-circle-fill"></div>
            <div class="hotline-phone-ring-img-circle">
                <a href="tel:0987654321" class="pps-btn-img">
                    <img src="https://wiki.minhduy.vn/wp-content/uploads/2022/07/icon-call-nh.png" alt="Gọi điện thoại" width="50">
                </a>
            </div>
        </div>
        <div class="hotline-bar">
            <a href="tel:0987654321">
                <span class="text-hotline">0123456789</span>
            </a>
        </div>
    </div>
    <!----------------------------------------------------------------------------------------->

    @Scripts.Render("~/bundles/jquery")
