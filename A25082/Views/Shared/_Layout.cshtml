    document.addEventListener("DOMContentLoaded", function () {
        // Kiểm tra xem đã hiển thị modal chưa
        if (!sessionStorage.getItem("welcomeModalShown")) {
            var welcomeModal = new bootstrap.Modal(document.getElementById("welcomeModal"));
            welcomeModal.show();

            // Đánh dấu là đã hiển thị
            sessionStorage.setItem("welcomeModalShown", "true");
        }
    });

    
    //----------------------------------------
    // Sidebar  - right - Lagre
    // Sidebar - mở sidebar
    function SidebarRight(open = true) {
        const sidebar = document.getElementById("sidebar_right");
        const overlay = document.getElementById("overlay");

        if (open) {
            sidebar.classList.add("open");
            overlay.classList.add("active");
        } else {
            sidebar.classList.remove("open");
            overlay.classList.remove("active");
        }
    }

    // Đóng sidebar khi nhấn overlay
    document.getElementById("overlay").addEventListener("click", function () {
        SidebarRight(false);
    });

    // Thêm sản phẩm vào giỏ hàng và cập nhật sidebar -----------------------------------------------------------------------------------------------
    function addToCart(productId, color, size, quantity) {
        $.ajax({
            url: "/GioHang/AddToCart", // Sửa URL này
            type: "POST",
            data: { productId, color, size, quantity },
            success: function (response) {
                if (response.success) {
                    // Cập nhật nội dung sidebar
                    $(".body_pr_sidebar_r").html(response.cartHtml);
                    $("#cart_count").text(response.totalItems);

                    // Cập nhật số lượng trên icon cart
                    updateCartCount();

                    // Hiển thị thông báo thành công
                    Swal.fire({
                        icon: "success",
                        title: response.message,
                        toast: true,
                        position: "top-start",
                        showConfirmButton: false,
                        timer: 1500,
                        timerProgressBar: true,
                        customClass: {
                            popup: 'custom-swal'
                        }
                    });

                    // Mở sidebar
                    SidebarRight(true);
                } else {
                    alert(response.message);
                }
            },
            error: function () {
                alert("Có lỗi xảy ra!");
            }
        });
    }

    // Xóa sản phẩm khỏi giỏ hàng (AJAX) -----------------------------------------------------------------------------------------------
    $(document).on("click", ".remove-from-cart", function () {
        let productId = $(this).data("id");
        let color = $(this).data("color");
        let size = $(this).data("size");

        $.ajax({
            url: '/GioHang/RemoveFromCartSideBar',
            type: 'POST',
            data: { productId, color, size },
            success: function (response) {
                if (response.success) {
                    $(".body_pr_sidebar_r").html(response.cartHtml);
                    $("#cart_count").text(response.totalItems);

                    // Cập nhật số lượng trên icon cart
                    updateCartCount();

                    Swal.fire({
                        icon: "success",
                        title: response.message,
                        toast: true,
                        position: "top-start",
                        showConfirmButton: false,
                        timer: 1500,
                        timerProgressBar: true,
                        customClass: {
                            popup: 'custom-swal'
                        }
                    });
                } else {
                    alert(response.message);
                }
            },
            error: function () {
                alert("Có lỗi xảy ra!");
            }
        });
    });

    // Gọi updateCartCount khi trang load xong
    $(document).ready(function () {
        updateCartCount();
    });


    // Code cố định Navbar khi cuộn trang -----------------------------------------------------------------------------------------------

    document.addEventListener('DOMContentLoaded', function () {
        const section = document.querySelector('.seaction_two');
        const sectionTop = section.offsetTop;
        let lastScrollTop = 0;
        let ticking = false;

        function handleScroll() {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

            if (!ticking) {
                window.requestAnimationFrame(function () {
                    if (scrollTop > sectionTop) {
                        section.classList.add('sticky');
                        if (scrollTop < lastScrollTop) {
                            // Scrolling up
                            section.classList.add('show');
                        } else {
                            // Scrolling down
                            section.classList.remove('show');
                        }
                    } else {
                        section.classList.remove('sticky', 'show');
                    }
                    lastScrollTop = scrollTop;
                    ticking = false;
                });

                ticking = true;
            }
        }

        window.addEventListener('scroll', handleScroll, { passive: true });
    });
    // -----------------------------------------------------------------------------------------------------------------------------------------
    $(document).ready(function () {
        $("#searchInput").on("keyup", function () {
            let keyword = $(this).val();
            if (keyword.length >= 2) {
                $.ajax({
                    url: '/Search/SuggestProducts',
                    type: 'GET',
                    data: { query: keyword },
                    success: function (response) {
                        $("#suggestion-list").empty().show();
                        if (response.length > 0) {
                            response.forEach(product => {
                                $("#suggestion-list").append(
                                    `<li data-id="${product.Id}">
                                   <a href="/SanPham/PageDeTailsProduct/${product.MaKem}" style="display: flex; align-items: center; text-decoration: none; color: inherit;">
                                        <img src="${product.ImageUrl ?? '/images/no-image.png'}" width="50" height="60" style="margin-right: 10px;" alt="${product.TenKem}"/> 
                                        ${product.TenKem} - <span class="price-text">${Number(product.GiaGoc).toLocaleString('vi-VN', { style: 'currency', currency: 'VND' })}</span>
                                    </a>
                                </li>`
                                );

                            });
                        } else {
                            $("#suggestion-list").append("<li>Không tìm thấy sản phẩm</li>");
                        }
                    }
                });
            } else {
                $("#suggestion-list").hide();
            }
        });

        $(document).on("click", "#suggestion-list li", function () {
            let selectedProduct = $(this).text();
            $("#searchInput").val(selectedProduct);
            $("#suggestion-list").hide();
            $("#searchForm").submit();  // Chuyển hướng đến trang tìm kiếm khi chọn gợi ý
        });

        $(document).click(function (e) {
            if (!$(e.target).closest(".body_input_find").length) {
                $("#suggestion-list").hide();
            }
        });
    });
</script>

