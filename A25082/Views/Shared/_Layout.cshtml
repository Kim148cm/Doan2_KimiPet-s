    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10000;
    box-shadow: 0 6px 24px rgba(52, 199, 105, 0.45);
    transition: transform 0.3s cubic-bezier(.34,1.56,.64,1), box-shadow 0.3s;
    animation: pulse-toggle 2.5s infinite;
}

#chatbot-toggle:hover {
    transform: scale(1.1) rotate(-5deg);
    box-shadow: 0 10px 32px rgba(52, 199, 105, 0.6);
}

keyframes pulse-toggle {
    0%, 100% { box-shadow: 0 6px 24px rgba(52,199,105,0.45); }
    50%       { box-shadow: 0 6px 36px rgba(52,199,105,0.7), 0 0 0 10px rgba(52,199,105,0.08); }
}

