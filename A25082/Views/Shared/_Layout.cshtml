    bottom: 108px;
    right: 28px;
    width: 650px;
    height: 580px;
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.18), 0 4px 16px rgba(52,199,105,0.12);
