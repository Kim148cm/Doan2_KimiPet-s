        /*** css phần hiển thị gợi ý món */
   #chatbot-toggle {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 66px;
    height: 66px;
    background: linear-gradient(135deg, #1a7a3c, #34c769);
    border-radius: 50%;
