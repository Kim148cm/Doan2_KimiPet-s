<script>
    // AI chat box ------------
    // KEY GROQ : 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
    const chatbotToggle = document.getElementById("chatbot-toggle");
    const chatbotContainer = document.getElementById("chatbot-container");
    const chatbotClose = document.getElementById("chatbot-close");
    const chatbotMessages = document.getElementById("chatbot-messages");
    const chatbotInput = document.getElementById("chatbot-input");
    const chatbotSend = document.getElementById("chatbot-send");

    chatbotToggle.onclick = () => {
        chatbotContainer.classList.add("open");
        if (!chatbotMessages.dataset.initialized) {
            appendMessage("Xin chào 👋! Mình là trợ lý AI của Kimipet's. Bạn muốn tìm thức ăn hay phụ kiện cho thú cưng không? 🐾", "ai");
            chatbotMessages.dataset.initialized = "true";
        }
        chatbotInput.focus();
    };

    chatbotClose.onclick = () => chatbotContainer.classList.remove("open");

    chatbotSend.onclick = () => sendMessage();
    chatbotInput.addEventListener("keypress", e => { if (e.key === "Enter") sendMessage(); });

    function sendQuick(el) {
        chatbotInput.value = el.textContent.replace(/^[^\s]+\s/, ''); // bỏ emoji đầu
        sendMessage();
    }

    function appendMessage(text, sender) {
        const div = document.createElement("div");
        div.className = "message " + sender;

        const avatar = document.createElement("img");
        avatar.className = "avatar";
        avatar.src = sender === "ai"
            ? "https://cdn-icons-png.flaticon.com/512/8943/8943377.png"
            : "https://cdn-icons-png.flaticon.com/512/149/149071.png";

        const bubble = document.createElement("div");
        bubble.className = "bubble";
        bubble.innerHTML = text;

        if (sender === "ai") {
            div.appendChild(avatar);
            div.appendChild(bubble);
        } else {
            div.appendChild(bubble);
            div.appendChild(avatar);
        }

        chatbotMessages.appendChild(div);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }

    function showTyping() {
        const typingDiv = document.createElement("div");
        typingDiv.className = "message ai";
        typingDiv.id = "typing-indicator";
        typingDiv.innerHTML = `
        <img class="avatar" src="https://cdn-icons-png.flaticon.com/512/8943/8943377.png" />
        <div class="typing-indicator">
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
        </div>`;
        chatbotMessages.appendChild(typingDiv);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
    }

    function hideTyping() {
        const t = document.getElementById("typing-indicator");
        if (t) t.remove();
    }

    function sendMessage() {
        const message = chatbotInput.value.trim();
        if (!message) return;

        appendMessage(message, "user");
        chatbotInput.value = "";
        showTyping();

        fetch("/SanPham/ChatBot", {


            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message: message })
        })
            .then(res => res.json())
            .then(data => {
                hideTyping();
                appendMessage(data.reply, "ai");
            })
            .catch(err => {
                hideTyping();
                appendMessage("😔 Xin lỗi, có lỗi kết nối. Vui lòng thử lại!", "ai");
                console.error(err);
            });
    }


