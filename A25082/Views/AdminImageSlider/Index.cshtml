@model IEnumerable<A25082.Models.Slider>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<div class="container mt-4">
    <h5 class="mb-0">  <i class="fa-solid fa-sliders class-icons"></i>  QUẢN LÝ DANH MỤC HÌNH ẢNH SLIDER</h5>

    <!-- Form Thêm / Sửa Slider -->
    <div class="card p-4 shadow" style="margin-top:1rem;">
        <input type="hidden" id="sliderId" value="0">

        <div class="mb-3">
            <label class="form-label">Chọn Hình Ảnh:</label>
            <input type="file" id="imageFile" class="form-control" accept="image/*">
        </div>

        <div class="mb-3">
            <label class="form-label">Hoặc nhập URL hình ảnh:</label>
            <input type="text" id="imageUrl" class="form-control" placeholder="Nhập URL hình ảnh">
        </div>

        <!-- Ảnh xem trước -->
        <img id="previewImage" src="" alt="Xem trước hình ảnh" class="img-thumbnail mt-2" style="max-width: 200px; display: none;">

        <div class="mb-3">
            <label class="form-label">Danh Mục Hình Ảnh:</label>
            <select id="imageCategory" class="form-select">
                @foreach (var category in (List<A25082.Models.LoaiAnh>)ViewBag.ImageCategories)
                {
                    <option value="@category.MaLoaiAnh">@category.TenLoaiAnh</option>
                }
            </select>
        </div>

        <div class="d-flex gap-2">

            <button class="btn btn-success" onclick="saveSlider()"> <i class="fas fa-save"></i> Lưu thông tin</button>
            <button class="btn btn-secondary" onclick="resetForm()"> <i class="fas fa-times"></i> Hủy bỏ</button>
        </div>
    </div>


    <div class="container mt-4">
        <div class="card shadow-sm" style="padding:1rem;">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-list"></i> DANH SÁCH DANH MỤC HÌNH ẢNH SLIDER </h5>
            </div>
            <!-- Danh sách Slider -->
            <table class="table table-bordered table-striped mt-4 shadow">
                <thead class="table-dark">
                    <tr>
                        <th>Hình Ảnh</th>
                        <th>Danh Mục</th>

                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody id="sliderTable">
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.MaSlider">
                            <td><img src="@item.ImageUrl" class="img-thumbnail" style="width: 100px;"></td>
                            <td>@item.LoaiAnh.TenLoaiAnh</td>

                            <td>
                                <button class="btn btn-warning btn-sm"
                                        onclick="editSlider(@item.MaSlider, '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.ImageUrl))', @item.MaLoaiAnh)">
                                    <i class="fas fa-edit"></i> Sửa
                                </button>

                                <button class="btn btn-danger btn-sm" onclick="deleteSlider(@item.MaSlider)"> <i class="fas fa-trash-alt"></i> Xóa</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


    </div>
</div>


<style>
    .class-icons {
        background-color: forestgreen;
        color: white;
        padding: 1rem;
        border-radius: 50%;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

    // CODE XỬ LÝ THÊM DỮ LIỆU MỚI -------------------------------------------------------

    function saveSlider() {
        var id = $("#sliderId").val();
        var categoryId = $("#imageCategory").val();
        var imageUrl = $("#imageUrl").val();
        var file = $("#imageFile")[0].files[0];

        if (!imageUrl && !file) {
            Swal.fire("Lỗi!", "Vui lòng chọn hoặc nhập URL hình ảnh!", "error");
            return;
        }

        var formData = new FormData();
        formData.append("Id", id);
        formData.append("ImageCategoryId", categoryId);

        if (file) {
            formData.append("ImageFile", file);
        } else {
            formData.append("ImageUrl", imageUrl);
        }

        $.ajax({
            type: "POST",
            url: "/AdminImageSlider/SaveSlider",
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res.success) {
                    Swal.fire("Thành công!", "Lưu hình ảnh thành công!", "success").then(() => location.reload());
                } else {
                    Swal.fire("Lỗi!", res.message, "error");
                }
            },
            error: function () {
                Swal.fire("Lỗi!", "Có lỗi xảy ra, vui lòng thử lại!", "error");
            }
        });
    }


    // CODE CẬP NHẬT THAY ĐỔI ẢNH SLIDER ----------------------------------------------------

    function editSlider(id, imageUrl, categoryId) {
        let originalImageUrl = imageUrl; // Lưu URL ảnh ban đầu

        Swal.fire({
            title: 'CHỈNH SỬA SLIDER',
            html: `
            <input type="hidden" id="editSliderId" value="${id}">
            <div class="mb-3">
                <label for="editSliderImageFile" class="form-label fw-bold">Chọn ảnh mới:</label>
                <input type="file" id="editSliderImageFile" class="form-control" accept="image/*">
            </div>
            <div class="mb-3">
                <label for="editSliderImage" class="form-label fw-bold">Hoặc nhập URL hình ảnh:</label>
                <input type="text" id="editSliderImage" class="form-control" value="${imageUrl}">
            </div>
            <div class="mb-3 text-center">
                <img id="previewImage" src="${imageUrl}" class="img-fluid" style="max-height: 200px; display: ${imageUrl ? 'block' : 'none'}">
            </div>
            <div class="mb-3">
                <label for="editSliderCategory" class="form-label fw-bold">Chọn danh mục:</label>
                <select id="editSliderCategory" class="form-select">
                    ${$('#imageCategory').html()}
                </select>
            </div>
        `,
            didOpen: () => {
                $('#editSliderCategory').val(categoryId);

                // Khi nhập URL ảnh, cập nhật ảnh xem trước
                $('#editSliderImage').on('input', function () {
                    const newImageUrl = $(this).val().trim();
                    if (newImageUrl) {
                        $('#previewImage').attr("src", newImageUrl).show();
                    } else {
                        $('#previewImage').hide();
                    }
                });

                // Khi chọn file ảnh mới, cập nhật ảnh xem trước
                $('#editSliderImageFile').on('change', function (event) {
                    const file = event.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            $('#previewImage').attr("src", e.target.result).show();
                            $('#editSliderImage').val(""); // Xóa URL nếu chọn file
                        };
                        reader.readAsDataURL(file);
                    }
                });
            },
            showCancelButton: true,
            confirmButtonText: 'Cập nhật',
            cancelButtonText: 'Hủy',
            preConfirm: () => {
                const newId = $('#editSliderId').val();
                const newImageUrl = $('#editSliderImage').val().trim();
                const newCategoryId = $('#editSliderCategory').val();
                const newImageFile = $('#editSliderImageFile')[0].files[0];

                // Kiểm tra xem có thay đổi ảnh không
                if (!newImageFile && newImageUrl === originalImageUrl) {
                    Swal.fire({
                        icon: 'info',
                        title: 'Không có thay đổi',
                        text: 'Bạn chưa thay đổi hình ảnh.',
                        confirmButtonText: 'OK'
                    });
                    return false;
                }

                // Trả về dữ liệu để xử lý AJAX
                return { Id: newId, ImageUrl: newImageUrl, ImageFile: newImageFile, CategoryId: newCategoryId };
            }
        }).then((result) => {
            if (result.isConfirmed && result.value) {
                const formData = new FormData();
                formData.append("Id", result.value.Id);
                formData.append("ImageCategoryId", result.value.CategoryId);

                if (result.value.ImageFile) {
                    formData.append("ImageFile", result.value.ImageFile);
                } else {
                    formData.append("ImageUrl", result.value.ImageUrl);
                }

                $.ajax({
                    url: '/AdminImageSlider/SaveSlider',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    beforeSend: function () {
                        Swal.fire({
                            title: "Đang cập nhật...",
                            text: "Vui lòng đợi...",
                            allowOutsideClick: false,
                            showConfirmButton: false,
                            didOpen: () => Swal.showLoading()
                        });
                    },
                    success: function (res) {
                        Swal.fire({
                            title: res.success ? "Cập nhật thành công!" : "Thất bại!",
                            text: res.message,
                            icon: res.success ? "success" : "error",
                            confirmButtonText: "OK"
                        }).then(() => {
                            if (res.success) location.reload();
                        });
                    }
                });
            }
        });
    }



    // -------------------------------------------------------------------------------------
    // CODE XỬ LÝ XÓA DỮ LIỆU

    function deleteSlider(id) {
        Swal.fire({
            title: "Bạn có chắc không?",
            text: "Hình ảnh sẽ bị xóa vĩnh viễn!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Xóa",
            cancelButtonText: "Hủy"
        }).then((result) => {
            if (result.isConfirmed) {
                $.post("/AdminImageSlider/DeleteSlider", { id: id }, function (res) {
                    if (res.success) {
                        Swal.fire("Đã xóa!", "Hình ảnh đã được xóa.", "success").then(() => location.reload());
                    } else {
                        Swal.fire("Lỗi!", res.message, "error");
                    }
                });
            }
        });
    }

    // -------------------------------------------------------------------------------------
    // CODE RESET TRƯỜNG NHẬP
    function resetForm() {
        $("#sliderId").val("0");
        $("#imageUrl").val("");
        $("#imageFile").val("");
        $("#imageCategory").val($("#imageCategory option:first").val());
        $("#previewImage").hide();

        Swal.fire({
            title: "Đã đặt lại!",
            text: "Trường nhập và File ảnh đã được đặt lại.",
            icon: "info",
            confirmButtonText: "OK"
        });
    }

    // -------------------------------------------------------------------------------------
    // CODE HIỂN THỊ ẢNH KHI CHỌN TỪ MÁY

    $("#imageFile").change(function (event) {
        const file = event.target.files[0];
        const preview = $("#previewImage");

        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.attr("src", e.target.result).show();
            };
            reader.readAsDataURL(file);
        }
    });

    $("#imageUrl").on("input", function () {
        const url = $(this).val();
        const preview = $("#previewImage");

        if (url) {
            preview.attr("src", url).show();
        } else {
            preview.hide();
        }
    });
    // -------------------------------------------------------------------------------------
</script>
