@model List<WebCafe.Models.DichVuSpa>
@{
    ViewBag.Title = "Dịch Vụ Spa Thú Cưng | Kimipet's";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Baloo+2:wght@700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --green: #1a7a3c;
        --green-lt: #f0faf4;
        --green-md: #e0f2e9;
        --green-dk: #145f2e;
        --gold: #f5c518;
        --border: #e5e5e5;
        --text: #1a1a1a;
        --text2: #555;
        --text3: #999;
        --bg: #f7f9f7;
        --white: #fff;
        --r: 14px;
        --font: 'Nunito', sans-serif;
    }

    /* ── Page ── */
    .dv-page {
        background: var(--bg);
        min-height: 80vh;
        padding-bottom: 70px;
        font-family: var(--font);
    }

    /* ── Hero ── */
    .dv-hero {
        background: linear-gradient(135deg, #0f3c1e 0%, #1a7a3c 55%, #34c769 100%);
        padding: 60px 24px 100px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .dv-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
        }

    .dv-hero-emoji {
        font-size: 60px;
        display: block;
        margin-bottom: 14px;
        animation: floatPaw 3s ease-in-out infinite;
    }

    @@keyframes floatPaw {
        0%, 100% {
            transform: translateY(0) rotate(-5deg);
        }

        50% {
            transform: translateY(-10px) rotate(5deg);
        }
    }

    .dv-hero h1 {
        font-family: 'Baloo 2', cursive;
        font-size: 38px;
        font-weight: 800;
        color: #fff;
        margin: 0 0 12px;
        text-shadow: 0 2px 12px rgba(0,0,0,.2);
    }

    .dv-hero p {
        font-size: 16px;
        color: rgba(255,255,255,.85);
        max-width: 560px;
        margin: 0 auto 28px;
        line-height: 1.65;
    }

    .dv-hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: #fff;
        color: var(--green);
        font-weight: 800;
        font-size: 15px;
        padding: 13px 32px;
        border-radius: 50px;
        text-decoration: none;
        box-shadow: 0 6px 24px rgba(0,0,0,.18);
        transition: all .2s;
    }

        .dv-hero-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 32px rgba(0,0,0,.25);
            color: var(--green-dk);
        }

    /* Wavy divider */
    .dv-wave {
        display: block;
        margin-top: -1px;
    }

    /* ── Stats bar ── */
    .dv-stats {
        max-width: 900px;
        margin: -28px auto 0;
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 16px;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    .dv-stat {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 20px 16px;
        text-align: center;
        box-shadow: 0 4px 16px rgba(0,0,0,.07);
    }

    .dv-stat-num {
        font-family: 'Baloo 2', cursive;
        font-size: 32px;
        font-weight: 800;
        color: var(--green);
        line-height: 1;
    }

    .dv-stat-lbl {
        font-size: 13px;
        font-weight: 700;
        color: var(--text3);
        margin-top: 4px;
    }

    /* ── Section title ── */
    .dv-section-head {
        max-width: 1100px;
        margin: 48px auto 24px;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .dv-section-title {
        font-family: 'Baloo 2', cursive;
        font-size: 24px;
        font-weight: 800;
        color: var(--text);
        margin: 0;
    }

        .dv-section-title span {
            color: var(--green);
        }

    .dv-section-sub {
        font-size: 13.5px;
        color: var(--text3);
        font-weight: 600;
        margin-top: 4px;
    }

    /* ── Grid ── */
    .dv-grid {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
    }

    /* ── Card ── */
    .dv-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--r);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all .25s;
        position: relative;
    }

        .dv-card:hover {
            box-shadow: 0 10px 36px rgba(26,122,60,.14);
            transform: translateY(-4px);
            border-color: var(--green-md);
        }

        /* Top accent bar */
        .dv-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--green), #34c769);
            transform: scaleX(0);
            transition: transform .3s ease;
            transform-origin: left;
        }

        .dv-card:hover::before {
            transform: scaleX(1);
        }

    /* Card header */
    .dv-card-head {
        padding: 22px 22px 0;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .dv-card-icon {
        width: 52px;
        height: 52px;
        background: var(--green-lt);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
        border: 1px solid var(--green-md);
    }

    .dv-card-badge {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .5px;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 20px;
        background: var(--green-lt);
        color: var(--green);
        border: 1px solid var(--green-md);
        white-space: nowrap;
    }

        .dv-card-badge.popular {
            background: #fef3c7;
            color: #d97706;
            border-color: #fde68a;
        }

        .dv-card-badge.new {
            background: #ede9fe;
            color: #7c3aed;
            border-color: #ddd6fe;
        }

    /* Card body */
    .dv-card-body {
        padding: 14px 22px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .dv-card-name {
        font-size: 17px;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 8px;
        line-height: 1.3;
    }

    .dv-card-desc {
        font-size: 13.5px;
        color: var(--text2);
        line-height: 1.6;
        flex: 1;
        margin-bottom: 16px;
    }

    /* Meta row */
    .dv-card-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .dv-meta-chip {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text2);
        background: var(--bg);
        border: 1px solid var(--border);
        padding: 5px 12px;
        border-radius: 20px;
    }

        .dv-meta-chip i {
            color: var(--green);
            font-size: 12px;
        }

    /* Price */
    .dv-card-price {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin-bottom: 16px;
    }

    .dv-price-main {
        font-family: 'Baloo 2', cursive;
        font-size: 26px;
        font-weight: 800;
        color: var(--green);
    }

    .dv-price-unit {
        font-size: 13px;
        color: var(--text3);
        font-weight: 600;
    }

    /* CTA button */
    .dv-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        font-family: var(--font);
        transition: all .2s;
        box-shadow: 0 3px 12px rgba(26,122,60,.25);
    }

        .dv-btn:hover {
            background: var(--green-dk);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 5px 18px rgba(26,122,60,.35);
        }

        .dv-btn i {
            font-size: 14px;
        }

    /* ── Process section ── */
    .dv-process-wrap {
        max-width: 900px;
        margin: 56px auto 0;
        padding: 0 24px;
    }

    .dv-process-title {
        font-family: 'Baloo 2', cursive;
        font-size: 22px;
        font-weight: 800;
        color: var(--text);
        text-align: center;
        margin-bottom: 32px;
    }

    .dv-process-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 20px;
        position: relative;
    }

        .dv-process-grid::before {
            content: '';
            position: absolute;
            top: 28px;
            left: 12.5%;
            right: 12.5%;
            height: 2px;
            background: linear-gradient(90deg, var(--green-md), var(--green), var(--green-md));
            z-index: 0;
        }

    .dv-step {
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .dv-step-num {
        width: 56px;
        height: 56px;
        background: var(--green);
        color: #fff;
        border-radius: 50%;
        border: 4px solid var(--bg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 900;
        margin: 0 auto 14px;
        box-shadow: 0 4px 16px rgba(26,122,60,.3);
    }

    .dv-step-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 5px;
    }

    .dv-step-desc {
        font-size: 12.5px;
        color: var(--text3);
        line-height: 1.5;
    }

    /* ── Note box ── */
    .dv-note-wrap {
        max-width: 900px;
        margin: 40px auto 0;
        padding: 0 24px;
    }

    .dv-note {
        background: #fff8e1;
        border: 1px solid #fde68a;
        border-left: 4px solid var(--gold);
        border-radius: 10px;
        padding: 16px 20px;
        font-size: 13.5px;
        color: #7a5c00;
        line-height: 1.7;
    }

        .dv-note strong {
            color: #5a4400;
        }

    /* ── CTA banner ── */
    .dv-cta-wrap {
        max-width: 900px;
        margin: 40px auto 0;
        padding: 0 24px;
    }

    .dv-cta-banner {
        background: linear-gradient(135deg, #1a7a3c, #34c769);
        border-radius: 16px;
        padding: 36px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .dv-cta-text h3 {
        font-family: 'Baloo 2', cursive;
        font-size: 22px;
        font-weight: 800;
        color: #fff;
        margin: 0 0 6px;
    }

    .dv-cta-text p {
        font-size: 14px;
        color: rgba(255,255,255,.85);
        margin: 0;
        line-height: 1.5;
    }

    .dv-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: #fff;
        color: var(--green);
        font-weight: 800;
        font-size: 15px;
        padding: 13px 28px;
        border-radius: 50px;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 4px 16px rgba(0,0,0,.15);
        transition: all .2s;
    }

        .dv-cta-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,0,0,.2);
            color: var(--green-dk);
        }

    /* ── Responsive ── */
    @@media (max-width: 780px) {
        .dv-hero h1 {
            font-size: 28px;
        }

        .dv-stats {
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
        }

        .dv-process-grid {
            grid-template-columns: repeat(2,1fr);
        }

            .dv-process-grid::before {
                display: none;
            }

        .dv-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .dv-stats {
            grid-template-columns: 1fr;
        }

        .dv-cta-banner {
            text-align: center;
            justify-content: center;
        }
    }
</style>

<div class="dv-page">

    <!-- ── Hero ── -->
    <div class="dv-hero">
       
        <h1>Dịch Vụ Spa Thú Cưng</h1>
        <p>Đội ngũ groomer chuyên nghiệp, sản phẩm cao cấp an toàn — mang lại trải nghiệm thư giãn tốt nhất cho boss của bạn.</p>
        <a href="@Url.Action("DatLich", "Spa")" class="dv-hero-cta">
            <i class="fa-solid fa-calendar-plus"></i> Đặt lịch ngay hôm nay
        </a>
    </div>

    <svg class="dv-wave" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 48" fill="var(--bg)">
        <path d="M0,48 C480,0 960,0 1440,48 L1440,48 L0,48 Z" />
    </svg>

    <!-- ── Stats ── -->
    <div class="dv-stats">
        <div class="dv-stat">
            <div class="dv-stat-num">500+</div>
            <div class="dv-stat-lbl">Thú cưng đã phục vụ</div>
        </div>
        <div class="dv-stat">
            <div class="dv-stat-num">@(Model?.Count ?? 0)</div>
            <div class="dv-stat-lbl">Dịch vụ đang cung cấp</div>
        </div>
        <div class="dv-stat">
            <div class="dv-stat-num">4.9★</div>
            <div class="dv-stat-lbl">Đánh giá trung bình</div>
        </div>
    </div>

    <!-- ── Service grid ── -->
    <div class="dv-section-head">
        <div>
            <h2 class="dv-section-title">Bảng giá <span>dịch vụ</span></h2>
            <p class="dv-section-sub">Giá đã bao gồm tất cả vật tư, không phát sinh thêm</p>
        </div>
        <a href="@Url.Action("DatLich","Spa")"
           style="display:inline-flex;align-items:center;gap:7px;background:var(--green);color:#fff;padding:10px 20px;border-radius:9px;font-size:13.5px;font-weight:800;text-decoration:none;">
            <i class="fa-solid fa-calendar-plus"></i> Đặt lịch
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="dv-grid">
            @{
                var icons = new[] { "🛁", "🚿", "✂️", "💎", "💅", "🌟", "🦷", "🎨" };
                var badges = new[] { "", "popular", "new", "", "popular", "new", "", "" };
                var badgeLabels = new[] { "Cơ bản", "Phổ biến", "Mới", "Tiết kiệm", "Bán chạy", "Hot", "Phổ biến", "Đặc biệt" };
                int idx = 0;
            }
            @foreach (var dv in Model)
            {
                string icon = icons[idx % icons.Length];
                string bcls = badges[idx % badges.Length];
                string blbl = badgeLabels[idx % badgeLabels.Length];
                idx++;

                <div class="dv-card">
                    <div class="dv-card-head">
                        <div class="dv-card-icon">@icon</div>
                        <span class="dv-card-badge @bcls">@blbl</span>
                    </div>
                    <div class="dv-card-body">
                        <div class="dv-card-name">@dv.TenDichVu</div>
                        <div class="dv-card-desc">
                            @(string.IsNullOrEmpty(dv.MoTa) ? "Dịch vụ chăm sóc chuyên nghiệp cho thú cưng của bạn." : dv.MoTa)
                        </div>

                        <div class="dv-card-meta">
                            <span class="dv-meta-chip">
                                <i class="fa-regular fa-clock"></i>
                                ~@dv.ThoiGian phút
                            </span>
                            <span class="dv-meta-chip">
                                <i class="fa-solid fa-paw"></i>
                                Mọi giống
                            </span>
                        </div>

                        <div class="dv-card-price">
                            <span class="dv-price-main">@dv.GiaTien.ToString("N0")đ</span>
                            <span class="dv-price-unit">/ lần</span>
                        </div>

                        <a href="@Url.Action("DatLich","Spa")?dichVu=@dv.MaDichVu" class="dv-btn">
                            <i class="fa-solid fa-calendar-check"></i>
                            Đặt lịch dịch vụ này
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div style="text-align:center;padding:60px 20px;color:var(--text3);font-family:var(--font);">
            <div style="font-size:48px;margin-bottom:14px;">✂️</div>
            <h3 style="font-size:16px;font-weight:700;color:var(--text2);">Chưa có dịch vụ nào</h3>
            <p>Vui lòng quay lại sau.</p>
        </div>
    }

    <!-- ── Quy trình ── -->
    <div class="dv-process-wrap">
        <h3 class="dv-process-title">Quy trình phục vụ của chúng tôi</h3>
        <div class="dv-process-grid">
            <div class="dv-step">
                <div class="dv-step-num">1</div>
                <div class="dv-step-title">Đặt lịch online</div>
                <div class="dv-step-desc">Chọn dịch vụ, ngày giờ phù hợp trên website</div>
            </div>
            <div class="dv-step">
                <div class="dv-step-num">2</div>
                <div class="dv-step-title">Xác nhận lịch</div>
                <div class="dv-step-desc">Nhân viên xác nhận qua email trong 30 phút</div>
            </div>
            <div class="dv-step">
                <div class="dv-step-num">3</div>
                <div class="dv-step-title">Thực hiện dịch vụ</div>
                <div class="dv-step-desc">Groomer chuyên nghiệp chăm sóc tận tình</div>
            </div>
            <div class="dv-step">
                <div class="dv-step-num">4</div>
                <div class="dv-step-title">Nhận bé về nhà</div>
                <div class="dv-step-desc">Bé sạch đẹp, thơm tho, vui vẻ trở về</div>
            </div>
        </div>
    </div>

    <!-- ── Lưu ý ── -->
    <div class="dv-note-wrap">
        <div class="dv-note">
            <strong>📋 Lưu ý khi sử dụng dịch vụ:</strong><br>
            • Vui lòng mang theo <strong>phiếu tiêm phòng</strong> của thú cưng (nếu có).<br>
            • Đến trước giờ hẹn <strong>5–10 phút</strong> để hoàn tất thủ tục.<br>
            • Giá trên áp dụng cho thú cưng <strong>dưới 10kg</strong>. Phụ thu thêm cho thú cưng từ 10–20kg (+30%) và trên 20kg (+50%).<br>
            • Liên hệ <strong>039 4627 246</strong> nếu cần tư vấn thêm.
        </div>
    </div>

    <!-- ── CTA Banner ── -->
    <div class="dv-cta-wrap">
        <div class="dv-cta-banner">
            <div class="dv-cta-text">
                <h3>🐾 Sẵn sàng làm đẹp cho boss?</h3>
                <p>Đặt lịch ngay hôm nay — xác nhận trong 30 phút, giao tiền mặt khi đến!</p>
            </div>
            <a href="@Url.Action("DatLich","Spa")" class="dv-cta-btn">
                <i class="fa-solid fa-scissors"></i> Đặt lịch ngay
            </a>
        </div>
    </div>

</div>
