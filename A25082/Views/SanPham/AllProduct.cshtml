@{
    ViewBag.Title = "Tất cả sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<section class="body_top_pr">
    <div class="body_title_top">
        <h4 class="title_h_top">DANH SÁCH TẤT CẢ LOẠI HOT</h4>
    </div>

    <div class="filter-bar p-3 mb-4 rounded bg-white d-flex flex-wrap align-items-center justify-content-between">
        <!-- Sắp xếp -->
        <div class="d-flex">
           
            <select id="sortBy" class="form-select form-select-sm border-success">
                <option value="">Mới nhất</option>
                <option value="PriceAsc">Giá: Tăng dần</option>
                <option value="PriceDesc">Giá: Giảm dần</option>
            </select>
        </div>

        <!-- Lọc giá -->
        <div class="d-flex align-items-center flex-wrap">
            <label class="me-2 fw-bold text-secondary">
                <i class="bi bi-currency-exchange"></i> Giá từ:
            </label>
            <input type="number" id="minPrice" class="form-control form-control-sm border-success me-2" placeholder="Min" style="width: 90px;" />

            <label class="me-2">đến</label>
            <input type="number" id="maxPrice" class="form-control form-control-sm border-success me-2" placeholder="Max" style="width: 90px;" />

            <button id="filterBtn" class="btn btn-success btn-sm">
                <i class="bi bi-search"></i> Lọc
            </button>
        </div>
    </div>


    <div class="row" id="product-list">
        @Html.Action("LoadProductList", "SanPham")
    </div>
</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function loadProducts() {
        var sortOrder = $("#sortBy").val();
        var minPrice = $("#minPrice").val();
        var maxPrice = $("#maxPrice").val();

        $.ajax({
            url: '@Url.Action("LoadProductList", "SanPham")',
            type: 'GET',
            data: {
                sortOrder: sortOrder,
                minPrice: minPrice || null,
                maxPrice: maxPrice || null
            },
            success: function (response) {
                $("#product-list").html(response);
            },
            error: function () {
                alert("Lỗi khi tải sản phẩm.");
            }
        });
    }

    $(document).ready(function () {
        $("#sortBy").change(loadProducts);
        $("#filterBtn").click(loadProducts);
    });
</script>
<style>
    .filter-bar {
        margin-top:2rem;
        border: 1px solid #e6e6e6;
        transition: all 0.3s ease;
    }

        .filter-bar:hover {
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .filter-bar label {
            font-size: 14px;
        }

    .form-select-sm, .form-control-sm {
        border-radius: 6px;
        font-size: 14px;
    }

    .btn-success.btn-sm {
        border-radius: 6px;
        font-size: 14px;
    }
</style>