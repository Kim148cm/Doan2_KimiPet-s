<!-- SCRIPTS — chỉ thêm logic qty, không đụng cart -->
<!-- ════════════════════════════════════════════ -->
<script>
    /* ── Quantity ──────────────────────────────── */
    var MAX_STOCK = parseInt(document.getElementById('maxStock').value) || 99;

    function qtyChange(delta) {
        var input = document.getElementById('qtyInput');
        var val = Math.min(Math.max((parseInt(input.value) || 1) + delta, 1), MAX_STOCK);
        input.value = val;
        document.getElementById('btnDec').disabled = (val <= 1);
        document.getElementById('btnInc').disabled = (val >= MAX_STOCK);
    }

    function qtyChangeMobile(delta) {
        var input = document.getElementById('mobileQtyInput');
        input.value = Math.min(Math.max((parseInt(input.value) || 1) + delta, 1), MAX_STOCK);
    }

    // Init: disable nút − lúc mặc định = 1
    document.getElementById('btnDec').disabled = true;

    /* ── Star picker feedback ─────────────────── */
    var starLabels = {
        '1': 'Rất tệ', '2': 'Không hài lòng',
        '3': 'Tạm được', '4': 'Rất tốt', '5': 'Xuất sắc'
    };
    document.querySelectorAll('#starPicker input').forEach(function (r) {
        r.addEventListener('change', function () {
            document.getElementById('starFb').textContent = starLabels[this.value] || '';
        });
    });

    /* ── Submit review ────────────────────────── */
    function starsHtml(n) {
        var h = '';
        for (var i = 1; i <= 5; i++)
            h += '<span class="s' + (i <= n ? ' on' : '') + '">★</span>';
        return h;
    }

    function submitReview(productId) {
        var sel = document.querySelector('#starPicker input:checked');
        var comment = document.getElementById('reviewComment').value.trim();

        if (!sel) {
            Swal.fire({ icon: 'warning', title: 'Vui lòng chọn số sao.', showConfirmButton: false, timer: 1400 });
            return;
        }
        if (!comment) {
            Swal.fire({ icon: 'warning', title: 'Vui lòng nhập nhận xét.', showConfirmButton: false, timer: 1400 });
            return;
        }

        var stars = parseInt(sel.value);
        var today = new Date().toLocaleDateString('vi-VN');

        $.ajax({
            url: '/DanhGia/GuiDanhGia',
            type: 'POST',
            data: { maKem: productId, diem: stars, binhLuan: comment },
            complete: function () {
                var card = '<div class="rv-card" style="animation:fadeIn .3s ease">'
                    + '<div class="rv-top"><div>'
                    + '<span class="rv-author">Bạn</span>'
                    + '<div class="rv-card-stars">' + starsHtml(stars) + '</div>'
                    + '</div><span class="rv-date">' + today + '</span></div>'
                    + '<p class="rv-text">' + comment + '</p>'
                    + '<span class="rv-verified">Vừa đánh giá</span></div>';

                document.getElementById('reviewList').insertAdjacentHTML('afterbegin', card);
                sel.checked = false;
                document.getElementById('reviewComment').value = '';
                document.getElementById('starFb').textContent = '';

                Swal.fire({
                    title: 'Cảm ơn đánh giá của bạn',
                    icon: 'success', showConfirmButton: false,
                    timer: 1800, toast: true, position: 'top-end'
                });
            }
        });
    }

    /* ── Gắn số lượng từ qtyInput vào nút "Mua ngay" (Detail.js dùng btn_add_left) ── */
    // Detail.js gọi AddToCart với quantity cứng = 1.
    // Đoạn này override: trước khi Detail.js bắt sự kiện click, ta cập nhật
    // hidden input hoặc patch lại AJAX call bằng cách wrap $.ajax gốc.
    $(document).ready(function () {

        // Patch $.ajax để tự động inject quantity đúng vào mọi request AddToCart
        var _ajax = $.ajax;
        $.ajax = function (settings) {
            if (settings && settings.url && settings.url.indexOf('AddToCart') !== -1) {
                var qty = parseInt($('#qtyInput').val()) || 1;
                if (settings.data) {
                    if (typeof settings.data === 'string') {
                        // dạng query string: "productId=1&color=&size=&quantity=1"
                        settings.data = settings.data.replace(/quantity=\d+/, 'quantity=' + qty);
                        // nếu không có quantity thì thêm vào
                        if (settings.data.indexOf('quantity=') === -1) {
                            settings.data += '&quantity=' + qty;
                        }
                    } else if (typeof settings.data === 'object') {
                        settings.data.quantity = qty;
                    }
                }
            }
            return _ajax.call(this, settings);
        };

    });

    /* ── Tab (giữ nguyên gốc) ─────────────────── */
    $(document).ready(function () {
        $(".title_two_detail").click(function () {
            $(".title_two_detail").removeClass("active");
            $(".content").hide();
            $(this).addClass("active");
            $("#" + $(this).data("tab")).show();
        });

        function setupTabs(tabSelector, contentSelector) {
            $(tabSelector).click(function () {
                $(contentSelector).hide();
                $(this).addClass("active");
                $("#" + $(this).data("tab")).show();
            });
        }
        setupTabs(".title_two_detail", ".content");
        setupTabs(".title_next_detail", ".next_title");
    });
</script>
